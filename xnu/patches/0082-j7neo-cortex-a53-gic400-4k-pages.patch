+	/* Non-secure CPU interface: unmask all priorities, EOIR also deactivates. */
+	gicc_write32(GICC_PMR, 0xf0);
+	gicc_write32(GICC_BPR, 0);
+	gicc_write32(GICC_CTLR, GICC_CTLR_ENABLE);
+	__builtin_arm_isb(ISB_SY);
+	kprintf("SWEET GIC: cpu %u mpidr 0x%llx interface mask 0x%x\n", cpu,
+	    __builtin_arm_rsr64("MPIDR_EL1") & 0xffffULL, mask);
+}
+
+uint32_t
+sweet_gic_ack(void)
+{
+	return gicc_read32(GICC_IAR);
+}
+
+void
+sweet_gic_eoi(uint32_t iar)
+{
+	gicc_write32(GICC_EOIR, iar);
+}
+
+/*
+ * SGI to one logical CPU. Before that CPU has run pe_init_fiq its mask is
+ * unknown; Exynos 7870 numbers its interfaces cluster * 4 + core, which is
+ * used only then.
+ */
+void
+sweet_gic_send_sgi(unsigned int cpu, uint32_t phys_id)
+{
+	uint8_t mask = cpu < MAX_CPUS ? gic_cpu_mask[cpu] : 0;
+	if (mask == 0) {
