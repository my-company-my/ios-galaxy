+	unsigned int cpu = ml_get_cpu_number_local();
+	uint8_t mask = gic_read_own_mask();
+	if (cpu < MAX_CPUS) {
+		gic_cpu_mask[cpu] = mask;
+		__builtin_arm_dmb(DMB_ISH);
+	}
