+/*
+ * Galaxy J7 Neo: GIC-400 (GICv2). The kernel runs non-secure, so every
+ * interrupt it owns is Group 1 and arrives as an IRQ (sleh_irq). The
+ * distributor is set up once by the boot CPU; SGIs/PPIs and the CPU
+ * interface are banked and set up by each CPU here (PE_init_cpu).
+ *
+ * ADT /arm-io/gic reg = <GICD offset, size, GICC offset, size> relative to
+ * the arm-io base, the same layout the GICv3 code reads.
+ */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+/* GIC CPU interface mask (GICD_ITARGETSR byte) of each logical CPU. */
+static uint8_t gic_cpu_mask[MAX_CPUS];
+
+static inline uint32_t
+gicd_read32(uint32_t off)
+{
+	return *(volatile uint32_t *)(gicd_base + off);
+}
+
+static inline void
+gicd_write32(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(gicd_base + off) = value;
+}
+
+static inline uint32_t
+gicc_read32(uint32_t off)
+{
+	return *(volatile uint32_t *)(gicc_base + off);
+}
+
+static inline void
+gicc_write32(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(gicc_base + off) = value;
+}
+
+/*
+ * The CPU interface number is not architecturally tied to MPIDR: read it
+ * from the banked GICD_ITARGETSR0..7, which return the reading CPU's mask.
+ */
+static uint8_t
+gic_read_own_mask(void)
+{
+	for (uint32_t off = 0; off < 32; off += 4) {
+		uint32_t v = gicd_read32(GICD_ITARGETSR + off);
+		v |= v >> 16;
+		v |= v >> 8;
+		if (v & 0xff) {
+			return (uint8_t)(v & 0xff);
+		}
+	}
+	return 0;
+}
+
+static void
+gic_dist_init(void)
+{
+	uint32_t lines = ((gicd_read32(GICD_TYPER) & 0x1f) + 1) * 32;
+	uint8_t me = gic_read_own_mask();
+
+	/*
+	 * S-BOOT leaves the distributor enabled with Android's routing.
+	 * Start clean: every SPI disabled, not pending, not active, lowest
+	 * useful priority, level-triggered, routed to the boot CPU. Drivers
+	 * enable what they use (all of them poll today).
+	 */
+	gicd_write32(GICD_CTLR, 0);
+	for (uint32_t i = 32; i < lines; i += 32) {
+		gicd_write32(GICD_ICENABLER + i / 8, 0xffffffff);
+		gicd_write32(GICD_ICPENDR + i / 8, 0xffffffff);
+		gicd_write32(GICD_ICACTIVER + i / 8, 0xffffffff);
+	}
+	for (uint32_t i = 32; i < lines; i += 4) {
+		gicd_write32(GICD_IPRIORITYR + i, 0xa0a0a0a0);
+		gicd_write32(GICD_ITARGETSR + i, 0x01010101u * me);
+	}
+	for (uint32_t i = 32; i < lines; i += 16) {
+		gicd_write32(GICD_ICFGR + i / 4, 0);
+	}
+	gicd_write32(GICD_CTLR, GICD_CTLR_ENABLE);
+	kprintf("SWEET GIC: GIC-400 %u lines, boot CPU interface mask 0x%x, vtimer INTID %u\n",
+	    lines, me, sweet_vtimer_intid);
+}
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+
+	if (!gicd_base) {
+		void const *prop;
+		unsigned int prop_size;
+
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess || prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: GIC reg must be <GICD off, size, GICC off, size>", __func__);
+		}
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			uint32_t intid = timer_size == sizeof(uint32_t) ? *(const uint32_t *)timer_prop : 0;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
