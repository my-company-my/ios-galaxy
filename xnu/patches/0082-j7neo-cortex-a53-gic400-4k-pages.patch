+	/* Banked SGIs and PPIs: only the IPI SGI and the virtual timer. */
+	gicd_write32(GICD_ICENABLER, 0xffffffff);
+	gicd_write32(GICD_ICPENDR, 0xffffffff);
+	for (uint32_t i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR + i, 0xa0a0a0a0);
+	}
+	gicd_write32(GICD_ISENABLER, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
