+static void
+usb_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* UTMI reference clock select from the USB PLL rate (exynos5_rate_to_clk). */
+static int
+usb_refclk_fsel(uint64_t hz, uint32_t *fsel)
+{
+	static const struct { uint32_t hz, fsel; } t[] = {
+		{ 9600000, 0 }, { 10000000, 1 }, { 12000000, 2 }, { 19200000, 3 },
+		{ 20000000, 4 }, { 24000000, 5 }, { 26000000, 6 }, { 50000000, 7 },
+	};
+	for (unsigned i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+		/* Within 0.1 %: the PLL rate is computed from M/P/S. */
+		if (hz + hz / 1000 >= t[i].hz && hz <= t[i].hz + t[i].hz / 1000) {
+			*fsel = t[i].fsel;
+			return 0;
+		}
+	}
+	return EINVAL;
+}
