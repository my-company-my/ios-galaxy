+static int
+usb_power_and_phy(void)
+{
+	uint8_t v = 0;
+	int error;
+
+	/* 1. MUIC: route D+/D- to the SoC. */
+	error = sweet_i2c_write8(SWEET_I2C4, MUIC_ADDR, MUIC_REG_MANSW, MUIC_MANSW_USB);
+	printf("SWEET USB: MUIC MANSW=0x%02x %s\n", MUIC_MANSW_USB, error ? "FAILED" : "set");
+	if (error) {
+		return error;
+	}
+	/* 2. PHY 3.3 V supply. */
+	error = sweet_pmic_read8(PMIC_L8CTRL, &v);
+	if (error) {
+		return error;
+	}
+	if ((v & PMIC_LDO_VSEL_MASK) != PMIC_L8_3V3) {
+		printf("SWEET USB: PMIC LDO8 0x%02x is not programmed to 3.3 V: left alone\n", v);
+		return EINVAL;
+	}
+	if ((v & PMIC_LDO_ENABLE) != PMIC_LDO_ENABLE) {
+		error = sweet_pmic_write8(PMIC_L8CTRL, v | PMIC_LDO_ENABLE);
+		delay(1000);    /* S2MPU05_ENABLE_TIME_LDO 128 us */
+		if (error) {
+			return error;
+		}
+	}
+	printf("SWEET USB: LDO8 (3.3 V) was 0x%02x, now on\n", v);
+
+	/* 3. PHY out of isolation, 4. clocks. */
+	sweet_soc_set_bits(PMU_USBDRD_PHY_CONTROL, 1u << 1);
+	sweet_soc_set_bits(CMU_MIF + 0x29c, 1u << 21);         /* mux usb20drd refclk gate */
+	sweet_soc_set_bits(CMU_MIF + 0x89c, 1u << 0);          /* gout_mif_cmu_fsys_usb20drd_refclk */
+	sweet_soc_set_bits(CMU_FSYS + 0x200, (1u << 21) | (1u << 12)); /* usb_pll mux */
+	sweet_soc_set_bits(CMU_FSYS + 0x230, (1u << 21) | (1u << 12)); /* usb20drd phyclock user */
+	sweet_soc_set_bits(CMU_FSYS + 0x804, (1u << 20) | (1u << 21)); /* aclk_hsdrd, hclk_usb20_ctrl */
+	sweet_soc_set_bits(CMU_FSYS + 0x828, 1u << 0);         /* hsdrd_ref_clk */
+
+	uint64_t ref = sweet_pll1417x_hz(CMU_FSYS + 0x100);
+	uint32_t fsel = 0;
+	if (usb_refclk_fsel(ref, &fsel)) {
+		printf("SWEET USB: USB PLL at %llu Hz is not a PHY reference rate\n", ref);
+		return EINVAL;
+	}
+
+	/* 5. PHY UTMI init, step by step as exynos7870_usbdrd_utmi_init. */
+	vm_offset_t phy = ml_io_map(USBPHY_PA, 0x100);
+	if (phy == 0) {
+		return ENXIO;
+	}
+	uint32_t reg = usb_rd(phy, PHY_CLKRST);
+	reg = (reg & ~PHYCLKRST_REFCLKSEL) | PHYCLKRST_REFCLKSEL_PAD;
+	reg &= ~(PHYCLKRST_FSEL_UTMI | PHYCLKRST_FSEL_PIPE);
+	reg |= fsel << 5;
+	reg |= PHYCLKRST_EN_UTMISUSPEND | PHYCLKRST_COMMONONN | PHYCLKRST_PORTRESET;
+	usb_wr(phy, PHY_CLKRST, reg);
+	delay(10);
+	usb_wr(phy, PHY_CLKRST, reg & ~PHYCLKRST_PORTRESET);
+
+	reg = usb_rd(phy, PHY_HSPHYPLLTUNE);
+	reg = fsel == 5 ? (reg | HSPHYPLLTUNE_PLL_B_TUNE) : (reg & ~HSPHYPLLTUNE_PLL_B_TUNE);
+	reg = (reg & ~HSPHYPLLTUNE_PLL_P_TUNE) | 14;
+	usb_wr(phy, PHY_HSPHYPLLTUNE, reg);
+
+	reg = usb_rd(phy, PHY_HSPHYCTRL);
+	reg &= ~(HSPHYCTRL_SIDDQ | HSPHYCTRL_PHYSWRST | HSPHYCTRL_PHYSWRSTALL);
+	usb_wr(phy, PHY_HSPHYCTRL, reg);
+	delay(500);
+
+	reg = usb_rd(phy, PHY_LINKSYSTEM);
+	reg |= LINKSYSTEM_XHCI_VERSION_CONTROL;
+	reg = (reg & ~LINKSYSTEM_FLADJ_MASK) | (0x20u << 1);
+	reg |= LINKSYSTEM_FORCE_BVALID | LINKSYSTEM_FORCE_VBUSVALID;
+	usb_wr(phy, PHY_LINKSYSTEM, reg);
+
+	reg = usb_rd(phy, PHY_UTMI);
+	reg &= ~(PHYUTMI_FORCESLEEP | PHYUTMI_FORCESUSPEND | PHYUTMI_DMPULLDOWN |
+	    PHYUTMI_DPPULLDOWN | PHYUTMI_DRVVBUS);
+	reg |= PHYUTMI_VBUSVLDEXTSEL | PHYUTMI_VBUSVLDEXT | PHYUTMI_OTGDISABLE;
+	usb_wr(phy, PHY_UTMI, reg);
+
+	usb_wr(phy, PHY_LINKPORT, usb_rd(phy, PHY_LINKPORT) | LINKPORT_OVCR_U3_SEL | LINKPORT_OVCR_U2_SEL);
+
+	reg = usb_rd(phy, PHY_HSPHYCTRL);
+	usb_wr(phy, PHY_HSPHYCTRL, reg | HSPHYCTRL_PHYSWRST);
+	delay(20);
+	usb_wr(phy, PHY_HSPHYCTRL, usb_rd(phy, PHY_HSPHYCTRL) & ~HSPHYCTRL_PHYSWRST);
+
+	/* exynos7870_tunes_utmi_postinit: PHYPARAM0 tuning fields (whole low 26 bits). */
+	reg = usb_rd(phy, PHY_PARAM0) & ~0x03ffffffu;
+	reg |= (3u << 22) | (1u << 20) | (2u << 18) | (0u << 17) | (0u << 15) | (0u << 13) |
+	    (3u << 9) | (5u << 6) | (2u << 3) | (3u << 0);
+	usb_wr(phy, PHY_PARAM0, reg);
+	printf("SWEET USB: PHY up: ref %llu Hz fsel %u CLKRST 0x%08x UTMI 0x%08x HSPHYCTRL 0x%08x\n",
+	    ref, fsel, usb_rd(phy, PHY_CLKRST), usb_rd(phy, PHY_UTMI), usb_rd(phy, PHY_HSPHYCTRL));
+	return 0;
+}
