+/*
+ * Galaxy J7 Neo (Exynos 7870) SoC helpers shared by the built-in drivers:
+ * GPIO (pin controllers), the S3C-style I2C masters and clock gates.
+ * Register layouts follow Linux drivers/pinctrl/samsung (exynos7870 banks),
+ * drivers/i2c/busses/i2c-s3c2410.c and drivers/clk/samsung/clk-exynos7870.c.
+ * Everything is polled; call only from thread context.
+ */
+#ifndef _SWEET_EXYNOS_H
+#define _SWEET_EXYNOS_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* GPIO banks used on the J7 Neo (pin controller base + bank offset). */
+enum sweet_gpio_bank {
+	SWEET_GPA0,     /* ALIVE 0x139f0000 + 0x040: power key (0), PMIC irq (2), fuel gauge irq (3) */
+	SWEET_GPA1,     /* ALIVE + 0x060: home key (7), touchkey irq (4) */
+	SWEET_GPA2,     /* ALIVE + 0x080: volume up (0), volume down (1) */
+	SWEET_GPC0,     /* TOP 0x139b0000 + 0x020 */
+	SWEET_GPC1,     /* TOP + 0x040: I2C4 (MUIC) SDA/SCL (0, 1) */
+	SWEET_GPC4,     /* TOP + 0x060: I2C0 (fuel gauge) SDA/SCL (0, 1) */
+	SWEET_GPC8,     /* TOP + 0x0c0: I2C2 (touchkey) SDA/SCL (0, 1) */
+	SWEET_GPD1,     /* TOP + 0x100: touchkey 2.8 V enable (6) */
+	SWEET_GPC3,     /* TOUCH 0x139d0000 + 0x000: I2C1 SDA/SCL (0, 1), touch irq (2) */
+	SWEET_GPIO_BANKS
+};
+
+#define SWEET_PIN_INPUT         0x0
+#define SWEET_PIN_OUTPUT        0x1
+#define SWEET_PIN_FUNC2         0x2
+#define SWEET_PIN_EINT          0xf
+
+#define SWEET_PULL_NONE         0
+#define SWEET_PULL_DOWN         1
+#define SWEET_PULL_UP           3
+#define SWEET_PULL_KEEP         0xff    /* leave the pull setting as it is */
+
+int sweet_gpio_config(enum sweet_gpio_bank bank, unsigned pin, unsigned func, unsigned pull);
+int sweet_gpio_get(enum sweet_gpio_bank bank, unsigned pin);   /* 0/1, -1 on error */
+int sweet_gpio_set(enum sweet_gpio_bank bank, unsigned pin, bool high);
+
+/* S3C2440-compatible I2C masters (i2c0..i2c4 of the Exynos 7870). */
+enum sweet_i2c_bus {
+	SWEET_I2C0,     /* 0x13830000: S2MU005 fuel gauge (0x3b) */
+	SWEET_I2C1,     /* 0x13840000: Melfas MIP4 touch screen (0x48) */
+	SWEET_I2C2,     /* 0x13850000: Coreriver TC350K touch keys (0x20) */
+	SWEET_I2C4,     /* 0x13870000: S2MU005 MUIC/charger (0x3d) */
+	SWEET_I2C_BUSES
+};
+
+/*
+ * One write (wlen bytes, may be 0) followed by a repeated-start read
+ * (rlen bytes, may be 0), then STOP. Returns 0, ENXIO (no ACK), ETIMEDOUT
+ * or EIO.
+ */
+int sweet_i2c_xfer(enum sweet_i2c_bus bus, uint8_t addr, const uint8_t *wbuf, unsigned wlen,
+    uint8_t *rbuf, unsigned rlen);
+int sweet_i2c_read8(enum sweet_i2c_bus bus, uint8_t addr, uint8_t reg, uint8_t *val);
+int sweet_i2c_write8(enum sweet_i2c_bus bus, uint8_t addr, uint8_t reg, uint8_t val);
+
+/*
+ * S2MPU05 PMIC on the HSI2C0 controller (0x10510000, address 0x66), which
+ * S-BOOT leaves configured. Auto-mode transfers like Linux i2c-exynos5.c.
+ */
+int sweet_pmic_read8(uint8_t reg, uint8_t *val);
+int sweet_pmic_write8(uint8_t reg, uint8_t val);
+
+/* Set (enable) bits of a CMU/PMU register: read-modify-write, never clears. */
+void sweet_soc_set_bits(uint64_t pa, uint32_t bits);
+uint32_t sweet_soc_read(uint64_t pa);
+/* Rate of a pll_1417x PLL from its CON0 register (26 MHz oscillator). 0 if off. */
+uint64_t sweet_pll1417x_hz(uint64_t con0_pa);
+
+#endif /* _SWEET_EXYNOS_H */
--- /dev/null
+++ b/bsd/dev/sweet_exynos.c
@@ -0,0 +1,502 @@
+/*
+ * Galaxy J7 Neo (Exynos 7870) SoC helpers: GPIO, S3C I2C masters, clocks.
+ * See sweet_exynos.h. Sources for every register: Linux
+ *   drivers/pinctrl/samsung/pinctrl-exynos-arm64.c (exynos7870_pin_banks*)
+ *   drivers/i2c/busses/i2c-s3c2410.c
+ *   drivers/clk/samsung/clk-exynos7870.c, clk-pll.c (pll_1417x)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_exynos.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define OSC_HZ                  26000000ull
+
+#define PINCTRL_ALIVE           0x139f0000u
+#define PINCTRL_TOP             0x139b0000u
+#define PINCTRL_TOUCH           0x139d0000u
+
+/* Bank registers: CON (4 bits/pin), DAT (1), PUD (2), DRV (3) */
+#define GPIO_CON                0x00
+#define GPIO_DAT                0x04
+#define GPIO_PUD                0x08
+
+static const struct {
+	uint32_t ctl, off;
+	uint8_t npins;
+} gpio_banks[SWEET_GPIO_BANKS] = {
+	[SWEET_GPA0] = { PINCTRL_ALIVE, 0x040, 8 },
+	[SWEET_GPA1] = { PINCTRL_ALIVE, 0x060, 8 },
+	[SWEET_GPA2] = { PINCTRL_ALIVE, 0x080, 8 },
+	[SWEET_GPC0] = { PINCTRL_TOP, 0x020, 3 },
+	[SWEET_GPC1] = { PINCTRL_TOP, 0x040, 4 },
+	[SWEET_GPC4] = { PINCTRL_TOP, 0x060, 4 },
+	[SWEET_GPC8] = { PINCTRL_TOP, 0x0c0, 2 },
+	[SWEET_GPD1] = { PINCTRL_TOP, 0x100, 7 },
+	[SWEET_GPC3] = { PINCTRL_TOUCH, 0x000, 3 },
+};
+
+static LCK_GRP_DECLARE(sweet_soc_grp, "sweet_soc");
+static LCK_MTX_DECLARE(sweet_gpio_lock, &sweet_soc_grp);
+static vm_offset_t gpio_va[3];      /* alive, top, touch */
+
+static vm_offset_t
+gpio_bank_va(enum sweet_gpio_bank bank)
+{
+	uint32_t ctl = gpio_banks[bank].ctl;
+	unsigned slot = ctl == PINCTRL_ALIVE ? 0 : (ctl == PINCTRL_TOP ? 1 : 2);
+	if (gpio_va[slot] == 0) {
+		gpio_va[slot] = ml_io_map(ctl, 0x1000);
+	}
+	return gpio_va[slot] ? gpio_va[slot] + gpio_banks[bank].off : 0;
+}
+
+static inline uint32_t
+rd32(vm_offset_t a)
+{
+	uint32_t v = *(volatile uint32_t *)a;
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr32(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+int
+sweet_gpio_config(enum sweet_gpio_bank bank, unsigned pin, unsigned func, unsigned pull)
+{
+	if (bank >= SWEET_GPIO_BANKS || pin >= gpio_banks[bank].npins) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_gpio_lock);
+	vm_offset_t b = gpio_bank_va(bank);
+	if (b == 0) {
+		lck_mtx_unlock(&sweet_gpio_lock);
+		return ENXIO;
+	}
+	if (pull != SWEET_PULL_KEEP) {
+		uint32_t pud = rd32(b + GPIO_PUD);
+		pud = (pud & ~(3u << (2 * pin))) | ((pull & 3u) << (2 * pin));
+		wr32(b + GPIO_PUD, pud);
+	}
+	uint32_t con = rd32(b + GPIO_CON);
+	con = (con & ~(0xfu << (4 * pin))) | ((func & 0xfu) << (4 * pin));
+	wr32(b + GPIO_CON, con);
+	lck_mtx_unlock(&sweet_gpio_lock);
+	return 0;
+}
+
+int
+sweet_gpio_get(enum sweet_gpio_bank bank, unsigned pin)
+{
+	if (bank >= SWEET_GPIO_BANKS || pin >= gpio_banks[bank].npins) {
+		return -1;
+	}
+	vm_offset_t b = gpio_bank_va(bank);
+	return b ? (int)((rd32(b + GPIO_DAT) >> pin) & 1) : -1;
+}
+
+int
+sweet_gpio_set(enum sweet_gpio_bank bank, unsigned pin, bool high)
+{
+	if (bank >= SWEET_GPIO_BANKS || pin >= gpio_banks[bank].npins) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_gpio_lock);
+	vm_offset_t b = gpio_bank_va(bank);
+	if (b) {
+		uint32_t dat = rd32(b + GPIO_DAT);
+		wr32(b + GPIO_DAT, high ? (dat | (1u << pin)) : (dat & ~(1u << pin)));
+	}
+	lck_mtx_unlock(&sweet_gpio_lock);
+	return b ? 0 : ENXIO;
+}
+
+/* ---- clocks ---- */
+
+#define CMU_MIF                 0x10460000u
+#define CMU_PERI                0x101f0000u
+#define MIF_MEDIA_PLL_CON0      (CMU_MIF + 0x120)
+#define MIF_BUS_PLL_CON0        (CMU_MIF + 0x140)
+#define MIF_MUX_PERI_BUS        (CMU_MIF + 0x2a0)       /* bit 12: 0 bus PLL/2, 1 media PLL/2 */
+#define MIF_DIV_PERI_BUS        (CMU_MIF + 0x4a0)       /* bits 3:0 */
+#define PERI_GATE_I2C           (CMU_PERI + 0x810)
+#define PERI_BUSP1_PERIC0_HCLK  (1u << 3)
+
+uint32_t
+sweet_soc_read(uint64_t pa)
+{
+	vm_offset_t page = ml_io_map(pa & ~0xfffULL, 0x1000);
+	return page ? rd32(page + (pa & 0xfff)) : 0;
+}
+
+void
+sweet_soc_set_bits(uint64_t pa, uint32_t bits)
+{
+	vm_offset_t page = ml_io_map(pa & ~0xfffULL, 0x1000);
+	if (page) {
+		vm_offset_t a = page + (pa & 0xfff);
+		wr32(a, rd32(a) | bits);
+	}
+}
+
+uint64_t
+sweet_pll1417x_hz(uint64_t con0_pa)
+{
+	uint32_t con = sweet_soc_read(con0_pa);
+	uint32_t mdiv = (con >> 16) & 0x3ff, pdiv = (con >> 8) & 0x3f, sdiv = con & 7;
+	if (!(con & (1u << 31)) || pdiv == 0) {
+		return 0;               /* PLL disabled */
+	}
+	return OSC_HZ * mdiv / ((uint64_t)pdiv << sdiv);
+}
+
+/* PCLK of the PERI I2C masters (gout_mif_cmu_peri_bus). */
+static uint64_t
+peri_bus_hz(void)
+{
+	bool media = (sweet_soc_read(MIF_MUX_PERI_BUS) >> 12) & 1;
+	uint64_t pll = sweet_pll1417x_hz(media ? MIF_MEDIA_PLL_CON0 : MIF_BUS_PLL_CON0);
+	uint32_t div = (sweet_soc_read(MIF_DIV_PERI_BUS) & 0xf) + 1;
+	return pll / 2 / div;
+}
+
+/* ---- S3C I2C ---- */
+
+#define IICCON                  0x00
+#define IICSTAT                 0x04
+#define IICADD                  0x08
+#define IICDS                   0x0c
+#define IICLC                   0x10
+
+#define IICCON_ACKEN            (1u << 7)
+#define IICCON_TXDIV_512        (1u << 6)
+#define IICCON_IRQPEND          (1u << 4)
+#define IICSTAT_MASTER_RX       (2u << 6)
+#define IICSTAT_MASTER_TX       (3u << 6)
+#define IICSTAT_START           (1u << 5)       /* write: START/STOP, read: bus busy */
+#define IICSTAT_TXRXEN          (1u << 4)
+#define IICSTAT_ARBITR          (1u << 3)
+#define IICSTAT_LASTBIT         (1u << 0)       /* 1 = no ACK received */
+#define IICLC_SDA_DELAY15       3u
+#define IICLC_FILTER_ON         (1u << 2)
+
+#define I2C_BYTE_TIMEOUT_US     20000
+#define I2C_HZ_MAX              100000u
+
+static const struct {
+	uint32_t pa;
+	uint32_t gate;          /* CMU_PERI 0x810 bit */
+	enum sweet_gpio_bank pins;
+	uint8_t pull;           /* DTS pin-pud of the bus pins */
+} i2c_buses[SWEET_I2C_BUSES] = {
+	[SWEET_I2C0] = { 0x13830000u, 1u << 21, SWEET_GPC4, SWEET_PULL_UP },
+	[SWEET_I2C1] = { 0x13840000u, 1u << 23, SWEET_GPC3, SWEET_PULL_UP },
+	[SWEET_I2C2] = { 0x13850000u, 1u << 22, SWEET_GPC8, SWEET_PULL_NONE },
+	[SWEET_I2C4] = { 0x13870000u, 1u << 17, SWEET_GPC1, SWEET_PULL_KEEP },
+};
+
+static LCK_MTX_DECLARE(sweet_i2c_lock, &sweet_soc_grp);
+static vm_offset_t i2c_va[SWEET_I2C_BUSES];
+static uint32_t i2c_con[SWEET_I2C_BUSES];      /* IICCON clock bits */
+
+static int
+i2c_setup(enum sweet_i2c_bus bus)
+{
+	if (i2c_va[bus]) {
+		return 0;
+	}
+	/* Bus pins to their I2C function (Linux pinctrl i2cN_bus), clocks on. */
+	sweet_gpio_config(i2c_buses[bus].pins, 0, SWEET_PIN_FUNC2, i2c_buses[bus].pull);
+	sweet_gpio_config(i2c_buses[bus].pins, 1, SWEET_PIN_FUNC2, i2c_buses[bus].pull);
+	sweet_soc_set_bits(PERI_GATE_I2C, PERI_BUSP1_PERIC0_HCLK | i2c_buses[bus].gate);
+
+	vm_offset_t r = ml_io_map(i2c_buses[bus].pa, 0x1000);
+	if (r == 0) {
+		return ENXIO;
+	}
+	/* Divider like s3c24xx_i2c_calcdivisor: SCL = pclk / div1 / divs <= 100 kHz. */
+	uint64_t pclk = peri_bus_hz();
+	if (pclk < 1000000 || pclk > 1000000000) {
+		printf("SWEET I2C: PERI bus clock %llu Hz implausible, assuming 200 MHz\n", pclk);
+		pclk = 200000000;
+	}
+	uint64_t want = (pclk + I2C_HZ_MAX - 1) / I2C_HZ_MAX;
+	uint32_t div1 = want > 16 * 16 ? 512 : 16;
+	uint32_t divs = (uint32_t)((want + div1 - 1) / div1);
+	divs = divs == 0 ? 1 : (divs > 16 ? 16 : divs);
+	i2c_con[bus] = (div1 == 512 ? IICCON_TXDIV_512 : 0) | (divs - 1);
+
+	wr32(r + IICADD, 0x10);         /* our own (slave) address, unused */
+	wr32(r + IICCON, 0);
+	wr32(r + IICSTAT, 0);
+	wr32(r + IICLC, IICLC_SDA_DELAY15 | IICLC_FILTER_ON);
+	wr32(r + IICCON, i2c_con[bus] | IICCON_ACKEN);
+	i2c_va[bus] = r;
+	printf("SWEET I2C: bus %u at 0x%x, pclk %llu Hz, SCL %llu Hz\n", bus, i2c_buses[bus].pa,
+	    pclk, pclk / div1 / divs);
+	return 0;
+}
+
+/* Wait for the byte-done flag (IRQPEND); returns IICSTAT, or -1 on timeout. */
+static int64_t
+i2c_wait(vm_offset_t r)
+{
+	for (unsigned us = 0; us < I2C_BYTE_TIMEOUT_US; us++) {
+		if (rd32(r + IICCON) & IICCON_IRQPEND) {
+			return rd32(r + IICSTAT);
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+/* Release the bus for the next byte; ack decides whether a received byte is ACKed. */
+static void
+i2c_continue(vm_offset_t r, bool ack)
+{
+	uint32_t con = rd32(r + IICCON) & ~(IICCON_IRQPEND | IICCON_ACKEN);
+	wr32(r + IICCON, con | (ack ? IICCON_ACKEN : 0));
+}
+
+static void
+i2c_stop(vm_offset_t r, uint32_t mode)
+{
+	wr32(r + IICSTAT, mode | IICSTAT_TXRXEN);       /* START bit clear: STOP */
+	wr32(r + IICCON, rd32(r + IICCON) & ~IICCON_IRQPEND);
+	for (unsigned us = 0; us < I2C_BYTE_TIMEOUT_US && (rd32(r + IICSTAT) & IICSTAT_START); us++) {
+		delay(1);
+	}
+}
+
+/*
+ * (Repeated) START + address byte, in the order of Linux
+ * s3c24xx_i2c_message_start: mode, address, START, and only then release
+ * the pending byte of a previous message. Returns 0 or an errno (STOP
+ * already sent on error).
+ */
+static int
+i2c_start(vm_offset_t r, enum sweet_i2c_bus bus, uint8_t addr, bool read)
+{
+	uint32_t mode = read ? IICSTAT_MASTER_RX : IICSTAT_MASTER_TX;
+	/* ACK on, clock setting; a pending flag (repeated start) stays set (writing 1 keeps it). */
+	wr32(r + IICCON, i2c_con[bus] | IICCON_ACKEN | (rd32(r + IICCON) & IICCON_IRQPEND));
+	wr32(r + IICSTAT, mode | IICSTAT_TXRXEN);
+	*(volatile uint8_t *)(r + IICDS) = (uint8_t)((addr << 1) | (read ? 1 : 0));
+	delay(1);                                       /* tx_setup */
+	wr32(r + IICSTAT, mode | IICSTAT_TXRXEN | IICSTAT_START);
+	wr32(r + IICCON, rd32(r + IICCON) & ~IICCON_IRQPEND);
+	int64_t st = i2c_wait(r);
+	if (st < 0) {
+		i2c_stop(r, mode);
+		return ETIMEDOUT;
+	}
+	if (st & (IICSTAT_LASTBIT | IICSTAT_ARBITR)) {
+		i2c_stop(r, mode);
+		return ENXIO;
+	}
+	return 0;
+}
+
+int
+sweet_i2c_xfer(enum sweet_i2c_bus bus, uint8_t addr, const uint8_t *wbuf, unsigned wlen,
+    uint8_t *rbuf, unsigned rlen)
+{
+	int error = 0;
+
+	if (bus >= SWEET_I2C_BUSES || (wlen == 0 && rlen == 0)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_i2c_lock);
+	error = i2c_setup(bus);
+	vm_offset_t r = i2c_va[bus];
+	if (error) {
+		goto out;
+	}
+	if (rd32(r + IICSTAT) & IICSTAT_START) {
+		/* Bus busy (a previous transfer was cut short): force a STOP. */
+		i2c_stop(r, IICSTAT_MASTER_TX);
+	}
+	if (wlen) {
+		error = i2c_start(r, bus, addr, false);
+		for (unsigned i = 0; !error && i < wlen; i++) {
+			*(volatile uint8_t *)(r + IICDS) = wbuf[i];
+			delay(1);
+			i2c_continue(r, true);
+			int64_t st = i2c_wait(r);
+			if (st < 0) {
+				error = ETIMEDOUT;
+			} else if (st & IICSTAT_LASTBIT) {
+				error = EIO;    /* data byte not acknowledged */
+			}
+			if (error) {
+				i2c_stop(r, IICSTAT_MASTER_TX);
+			}
+		}
+		if (error) {
+			goto out;
+		}
+		if (!rlen) {
+			i2c_stop(r, IICSTAT_MASTER_TX);
+			goto out;
+		}
+		/* Repeated START for the read: the controller needs a new START to turn around. */
+	}
+	if (rlen) {
+		error = i2c_start(r, bus, addr, true);
+		for (unsigned i = 0; !error && i < rlen; i++) {
+			/* ACK every byte except the last one. */
+			i2c_continue(r, i + 1 < rlen);
+			int64_t st = i2c_wait(r);
+			if (st < 0) {
+				error = ETIMEDOUT;
+				break;
+			}
+			rbuf[i] = *(volatile uint8_t *)(r + IICDS);
+		}
+		i2c_stop(r, IICSTAT_MASTER_RX);
+	}
+out:
+	lck_mtx_unlock(&sweet_i2c_lock);
+	return error;
+}
+
+int
+sweet_i2c_read8(enum sweet_i2c_bus bus, uint8_t addr, uint8_t reg, uint8_t *val)
+{
+	return sweet_i2c_xfer(bus, addr, &reg, 1, val, 1);
+}
+
+int
+sweet_i2c_write8(enum sweet_i2c_bus bus, uint8_t addr, uint8_t reg, uint8_t val)
+{
+	uint8_t b[2] = { reg, val };
+	return sweet_i2c_xfer(bus, addr, b, 2, NULL, 0);
+}
+/* ---- HSI2C (PMIC) ---- */
+
+#define HSI2C0_PA               0x10510000u
+#define PMIC_ADDR               0x66
+#define HSI2C_CTL               0x00
+#define HSI2C_FIFO_CTL          0x04
+#define HSI2C_INT_ENABLE        0x20
+#define HSI2C_INT_STATUS        0x24
+#define HSI2C_FIFO_STATUS       0x30
+#define HSI2C_TX_DATA           0x34
+#define HSI2C_RX_DATA           0x38
+#define HSI2C_AUTO_CONF         0x44
+#define HSI2C_TRANS_STATUS      0x50
+#define HSI2C_ADDR              0x70
+#define HSI2C_RXCHON            (1u << 6)
+#define HSI2C_TXCHON            (1u << 7)
+#define HSI2C_RXFIFO_EN         (1u << 0)
+#define HSI2C_TXFIFO_EN         (1u << 1)
+#define HSI2C_READ_WRITE        (1u << 16)
+#define HSI2C_STOP_AFTER_TRANS  (1u << 17)
+#define HSI2C_MASTER_RUN        (1u << 31)
+#define HSI2C_MASTER_BUSY       (1u << 17)
+#define HSI2C_INT_TRANS_DONE    (1u << 7)
+#define HSI2C_INT_TRANS_ABORT   (1u << 8)
+#define HSI2C_INT_NO_DEV_ACK    (1u << 9)
+#define HSI2C_INT_NO_DEV        (1u << 10)
+#define HSI2C_INT_TIMEOUT       (1u << 11)
+#define HSI2C_INT_TRANS         (HSI2C_INT_TRANS_DONE | HSI2C_INT_TRANS_ABORT | \
+	                         HSI2C_INT_NO_DEV_ACK | HSI2C_INT_NO_DEV | HSI2C_INT_TIMEOUT)
+#define HSI2C_RX_FIFO_EMPTY     (1u << 24)
+
+static LCK_MTX_DECLARE(sweet_pmic_lock, &sweet_soc_grp);
+static vm_offset_t hsi2c_va;
+
+/*
+ * One auto-mode message. The controller's SPI is disabled in the GIC
+ * (pe_fiq.c), so INT_ENABLE only makes INT_STATUS latch; it is polled.
+ */
+static int
+hsi2c_msg(bool read, uint8_t *buf, unsigned len, bool stop)
+{
+	vm_offset_t r = hsi2c_va;
+	uint32_t ctl = rd32(r + HSI2C_CTL) & ~(HSI2C_TXCHON | HSI2C_RXCHON);
+
+	for (unsigned us = 0; us < 20000 && (rd32(r + HSI2C_TRANS_STATUS) & HSI2C_MASTER_BUSY) && !read; us++) {
+		delay(1);
+	}
+	wr32(r + HSI2C_ADDR, (uint32_t)(PMIC_ADDR & 0x3ff) << 10);
+	wr32(r + HSI2C_FIFO_CTL, HSI2C_RXFIFO_EN | HSI2C_TXFIFO_EN |
+	    (read ? (len << 4) : (len << 16)));
+	wr32(r + HSI2C_CTL, ctl | (read ? HSI2C_RXCHON : HSI2C_TXCHON));
+	wr32(r + HSI2C_INT_STATUS, rd32(r + HSI2C_INT_STATUS));
+	wr32(r + HSI2C_INT_ENABLE, HSI2C_INT_TRANS);
+	if (!read) {
+		for (unsigned i = 0; i < len; i++) {
+			wr32(r + HSI2C_TX_DATA, buf[i]);
+		}
+	}
+	wr32(r + HSI2C_AUTO_CONF, (read ? HSI2C_READ_WRITE : 0) | (stop ? HSI2C_STOP_AFTER_TRANS : 0) |
+	    len | HSI2C_MASTER_RUN);
+	uint32_t st = 0;
+	unsigned us;
+	for (us = 0; us < 20000; us++) {
+		st = rd32(r + HSI2C_INT_STATUS);
+		if (st & HSI2C_INT_TRANS) {
+			break;
+		}
+		delay(1);
+	}
+	wr32(r + HSI2C_INT_STATUS, st);
+	wr32(r + HSI2C_INT_ENABLE, 0);
+	if (us == 20000 || !(st & HSI2C_INT_TRANS_DONE) || (st & (HSI2C_INT_TRANS & ~HSI2C_INT_TRANS_DONE))) {
+		printf("SWEET PMIC: HSI2C %s failed, status 0x%x\n", read ? "read" : "write", st);
+		return us == 20000 ? ETIMEDOUT : EIO;
+	}
+	if (read) {
+		for (unsigned i = 0; i < len; i++) {
+			if (rd32(r + HSI2C_FIFO_STATUS) & HSI2C_RX_FIFO_EMPTY) {
+				return EIO;
+			}
+			buf[i] = (uint8_t)rd32(r + HSI2C_RX_DATA);
+		}
+	}
+	return 0;
+}
+
+int
+sweet_pmic_read8(uint8_t reg, uint8_t *val)
+{
+	int error;
+	lck_mtx_lock(&sweet_pmic_lock);
+	if (hsi2c_va == 0) {
+		hsi2c_va = ml_io_map(HSI2C0_PA, 0x1000);
+	}
+	error = hsi2c_va ? hsi2c_msg(false, &reg, 1, false) : ENXIO;
+	if (!error) {
+		error = hsi2c_msg(true, val, 1, true);
+	}
+	lck_mtx_unlock(&sweet_pmic_lock);
+	return error;
+}
+
+int
+sweet_pmic_write8(uint8_t reg, uint8_t val)
+{
+	uint8_t b[2] = { reg, val };
+	int error;
+	lck_mtx_lock(&sweet_pmic_lock);
+	if (hsi2c_va == 0) {
+		hsi2c_va = ml_io_map(HSI2C0_PA, 0x1000);
+	}
+	error = hsi2c_va ? hsi2c_msg(false, b, 2, true) : ENXIO;
+	lck_mtx_unlock(&sweet_pmic_lock);
+	return error;
+}
