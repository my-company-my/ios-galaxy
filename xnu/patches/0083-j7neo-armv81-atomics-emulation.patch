+++ b/osfmk/arm64/machine_routines_asm.s
@@ -1311,6 +1311,118 @@
 
 #endif // defined(HAS_APPLE_PAC)
 
+#if defined(SWEET)
+/*
+ * int _sweet_cas_user(user_addr_t addr, uint64_t expected, uint64_t desired,
+ *                     unsigned size_log2, uint64_t *old)
+ *
+ * Galaxy J7 Neo (Cortex-A53, no LSE): compare-and-swap on naturally aligned
+ * user memory with LL/SC, for the trap-and-emulate path of ARMv8.1 atomics
+ * (osfmk/arm64/sweet_lse.c). Acquire+release exclusives plus a trailing
+ * DMB ISH give at least the ordering of the strongest LSE variant. *old
+ * receives the value found (zero-extended). Returns 0, or EFAULT through
+ * copyio_error when the access faults.
+ */
+	.text
+	.align 2
+	.globl EXT(_sweet_cas_user)
+LEXT(_sweet_cas_user)
+	ARM64_STACK_PROLOG
+	PUSH_FRAME
+	cmp		w3, #3
+	b.eq	Lsweet_cas64
+	cmp		w3, #2
+	b.eq	Lsweet_cas32
+	cmp		w3, #1
+	b.eq	Lsweet_cas16
+	and		x1, x1, #0xff
+	COPYIO_RECOVER_RANGE Lsweet_cas_done
+Lsweet_cas8:
+	ldaxrb	w8, [x0]
+	cmp		w8, w1
+	b.ne	Lsweet_cas_fail
+	stlxrb	w9, w2, [x0]
+	cbnz	w9, Lsweet_cas8
+	b		Lsweet_cas_done
+Lsweet_cas16:
+	and		x1, x1, #0xffff
+	COPYIO_RECOVER_RANGE Lsweet_cas_done
+Lsweet_cas16_loop:
+	ldaxrh	w8, [x0]
+	cmp		w8, w1
+	b.ne	Lsweet_cas_fail
+	stlxrh	w9, w2, [x0]
+	cbnz	w9, Lsweet_cas16_loop
+	b		Lsweet_cas_done
+Lsweet_cas32:
+	COPYIO_RECOVER_RANGE Lsweet_cas_done
+Lsweet_cas32_loop:
+	ldaxr	w8, [x0]
+	cmp		w8, w1
+	b.ne	Lsweet_cas_fail
+	stlxr	w9, w2, [x0]
+	cbnz	w9, Lsweet_cas32_loop
+	b		Lsweet_cas_done
+Lsweet_cas64:
+	COPYIO_RECOVER_RANGE Lsweet_cas_done
+Lsweet_cas64_loop:
+	ldaxr	x8, [x0]
+	cmp		x8, x1
+	b.ne	Lsweet_cas_fail
+	stlxr	w9, x2, [x0]
+	cbnz	w9, Lsweet_cas64_loop
+	b		Lsweet_cas_done
+Lsweet_cas_fail:
+	clrex
+Lsweet_cas_done:
+	dmb		ish
+	str		x8, [x4]
+	mov		x0, #0
+	POP_FRAME
+	ARM64_STACK_EPILOG
+
+/*
+ * int _sweet_casp_user(user_addr_t addr, uint64_t exp_lo, uint64_t exp_hi,
+ *                      uint64_t new_lo, uint64_t new_hi, unsigned is64,
+ *                      uint64_t old[2])
+ * Pair compare-and-swap (CASP): two 32-bit or two 64-bit words.
+ */
+	.text
+	.align 2
+	.globl EXT(_sweet_casp_user)
+LEXT(_sweet_casp_user)
+	ARM64_STACK_PROLOG
+	PUSH_FRAME
+	cbz		w5, Lsweet_casp32
+	COPYIO_RECOVER_RANGE Lsweet_casp_done
+Lsweet_casp64_loop:
+	ldaxp	x8, x9, [x0]
+	cmp		x8, x1
+	ccmp	x9, x2, #0, eq
+	b.ne	Lsweet_casp_fail
+	stlxp	w10, x3, x4, [x0]
+	cbnz	w10, Lsweet_casp64_loop
+	b		Lsweet_casp_done
+Lsweet_casp32:
+	COPYIO_RECOVER_RANGE Lsweet_casp_done
+Lsweet_casp32_loop:
+	ldaxp	w8, w9, [x0]
+	cmp		w8, w1
+	ccmp	w9, w2, #0, eq
+	b.ne	Lsweet_casp_fail
+	stlxp	w10, w3, w4, [x0]
+	cbnz	w10, Lsweet_casp32_loop
+	b		Lsweet_casp_done
+Lsweet_casp_fail:
+	clrex
+Lsweet_casp_done:
+	dmb		ish
+	stp		x8, x9, [x6]
+	mov		x0, #0
+	POP_FRAME
+	ARM64_STACK_EPILOG
+#endif /* SWEET */
+
