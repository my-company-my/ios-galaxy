+
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+extern int _sweet_cas_user(user_addr_t addr, uint64_t expected, uint64_t desired,
+    unsigned size_log2, uint64_t *old);
+extern int _sweet_casp_user(user_addr_t addr, uint64_t exp_lo, uint64_t exp_hi,
+    uint64_t new_lo, uint64_t new_hi, unsigned is64, uint64_t old[2]);
+
+int sweet_cas_user(user_addr_t addr, uint64_t expected, uint64_t desired,
+    unsigned size_log2, uint64_t *old);
+int sweet_casp_user(user_addr_t addr, uint64_t exp_lo, uint64_t exp_hi,
+    uint64_t new_lo, uint64_t new_hi, bool is64, uint64_t old[2]);
+
+/*
+ * Galaxy J7 Neo: atomic compare-and-swap on user memory for the ARMv8.1
+ * atomics emulation (sweet_lse.c). addr has the user TBI tag stripped by
+ * the caller. Returns 0 (with *old set), EFAULT or EINVAL (misaligned).
+ */
+int
+sweet_cas_user(user_addr_t addr, uint64_t expected, uint64_t desired,
+    unsigned size_log2, uint64_t *old)
+{
+	int result = copy_validate(addr, 0, 1u << size_log2,
+	    COPYIO_IN | COPYIO_OUT | COPYIO_ATOMIC | COPYIO_VALIDATE_USER_ONLY);
+	if (__improbable(result)) {
+		return result;
+	}
+	user_access_enable();
+	result = _sweet_cas_user(addr, expected, desired, size_log2, old);
+	user_access_disable();
+	return result;
+}
+
+int
+sweet_casp_user(user_addr_t addr, uint64_t exp_lo, uint64_t exp_hi,
+    uint64_t new_lo, uint64_t new_hi, bool is64, uint64_t old[2])
+{
+	int result = copy_validate(addr, 0, is64 ? 16 : 8,
+	    COPYIO_IN | COPYIO_OUT | COPYIO_ATOMIC | COPYIO_VALIDATE_USER_ONLY);
+	if (__improbable(result)) {
+		return result;
+	}
+	user_access_enable();
+	result = _sweet_casp_user(addr, exp_lo, exp_hi, new_lo, new_hi, is64 ? 1 : 0, old);
+	user_access_disable();
+	return result;
+}
+#endif /* SWEET */
