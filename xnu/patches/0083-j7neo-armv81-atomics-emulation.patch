--- /dev/null
+++ b/osfmk/arm64/sweet_lse.c
@@ -0,0 +1,263 @@
+/*
+ * Galaxy J7 Neo (Cortex-A53, ARMv8.0): trap-and-emulate the ARMv8.1 LSE
+ * atomics (CAS*, CASP*, LD<op>*, ST<op>*, SWP*) and ARMv8.3 LDAPR* for
+ * 64-bit user processes.
+ *
+ * The iOS 16 userland targets the A11 (ARMv8.2). If any binary uses these
+ * instructions unconditionally, the A53 raises an "unknown reason"
+ * exception (ESR EC 0) for them; handle_uncategorized() calls
+ * sweet_lse_emulate() before it turns the trap into SIGILL. Each emulated
+ * operation is a single atomic LL/SC compare-and-swap on the user address
+ * (osfmk/arm64/copyio.c, machine_routines_asm.s), so it stays atomic
+ * against both other emulated operations and native LDXR/STXR code on
+ * other cores. Every emulated instruction costs a trap: the counter
+ * sweet_lse_emulated and the first few logged PCs show whether this path
+ * is hot (tools/check-armv80.py finds such instructions offline).
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <stdint.h>
+#include <stdbool.h>
+#include <sys/errno.h>
+#include <mach/vm_param.h>
+#include <machine/atomic.h>
+#include <arm64/proc_reg.h>
+#include <arm/thread.h>
+#include <kern/misc_protos.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <mach/arm/thread_status.h>
+
+extern int sweet_cas_user(user_addr_t addr, uint64_t expected, uint64_t desired,
+    unsigned size_log2, uint64_t *old);
+extern int sweet_casp_user(user_addr_t addr, uint64_t exp_lo, uint64_t exp_hi,
+    uint64_t new_lo, uint64_t new_hi, bool is64, uint64_t old[2]);
+extern int copyin_atomic32(const user_addr_t user_addr, uint32_t *kernel_addr);
+extern int copyin_atomic64(const user_addr_t user_addr, uint64_t *kernel_addr);
+
+bool sweet_lse_emulate(arm_saved_state_t *state, uint32_t instr);
+
+uint64_t _Atomic sweet_lse_emulated;
+static uint32_t _Atomic sweet_lse_logged;
+
+/* Xn for n in 0..30; 31 is XZR here (Rs/Rt operands). */
+static uint64_t
+reg_get(arm_saved_state_t *state, unsigned n)
+{
+	arm_saved_state64_t *ss = saved_state64(state);
+	if (n < 29) {
+		return ss->x[n];
+	}
+	if (n == 29) {
+		return ss->fp;
+	}
+	if (n == 30) {
+		return ss->lr;
+	}
+	return 0;
+}
+
+static void
+reg_set(arm_saved_state_t *state, unsigned n, uint64_t v)
+{
+	if (n == 31) {
+		return; /* XZR: discarded (the ST<op> aliases) */
+	}
+	if (n == 30) {
+		set_saved_state_lr(state, v);
+	} else if (n == 29) {
+		set_saved_state_fp(state, v);
+	} else {
+		set_saved_state_reg(state, n, v);
+	}
+}
+
+/* Base register: SP when n == 31. TBI: the top byte is not part of the address. */
+static user_addr_t
+base_addr(arm_saved_state_t *state, unsigned n)
+{
+	uint64_t a = n == 31 ? get_saved_state_sp(state) : reg_get(state, n);
+	return (user_addr_t)(a & 0x00ffffffffffffffULL);
+}
+
+static uint64_t
+size_mask(unsigned size_log2)
+{
+	return size_log2 == 3 ? ~0ULL : ((1ULL << (8u << size_log2)) - 1);
+}
+
+static int64_t
+sign_extend(uint64_t v, unsigned size_log2)
+{
+	unsigned bits = 8u << size_log2;
+	if (bits == 64) {
+		return (int64_t)v;
+	}
+	uint64_t m = 1ULL << (bits - 1);
+	v &= size_mask(size_log2);
+	return (int64_t)((v ^ m) - m);
+}
+
+/* Value written back to a W/X register: 32-bit and smaller ops zero-extend. */
+static uint64_t
+result_value(uint64_t v, unsigned size_log2)
+{
+	return v & size_mask(size_log2);
+}
+
+/*
+ * Single-copy atomic read without writing (LDAPR must work on read-only
+ * pages): bytes and halfwords come from the naturally aligned word that
+ * contains them.
+ */
+static int
+read_user(user_addr_t addr, unsigned size_log2, uint64_t *out)
+{
+	if (size_log2 == 3) {
+		return copyin_atomic64(addr, out);
+	}
+	if (addr & ((1u << size_log2) - 1)) {
+		return EINVAL;
+	}
+	uint32_t w;
+	int error = copyin_atomic32(addr & ~3ULL, &w);
+	if (error) {
+		return error;
+	}
+	*out = (w >> (8 * (addr & 3))) & size_mask(size_log2);
+	return 0;
+}
+
+static bool
+emulate_cas(arm_saved_state_t *state, uint32_t instr)
+{
+	unsigned size_log2 = instr >> 30;
+	unsigned rs = (instr >> 16) & 31, rn = (instr >> 5) & 31, rt = instr & 31;
+	user_addr_t addr = base_addr(state, rn);
+	uint64_t expected = reg_get(state, rs) & size_mask(size_log2);
+	uint64_t desired = reg_get(state, rt) & size_mask(size_log2);
+	uint64_t old;
+
+	if (sweet_cas_user(addr, expected, desired, size_log2, &old)) {
+		return false;
+	}
+	reg_set(state, rs, result_value(old, size_log2));
+	return true;
+}
+
+static bool
+emulate_casp(arm_saved_state_t *state, uint32_t instr)
+{
+	bool is64 = (instr >> 30) & 1;
+	unsigned rs = (instr >> 16) & 31, rn = (instr >> 5) & 31, rt = instr & 31;
+	if ((rs & 1) || (rt & 1)) {
+		return false; /* UNDEFINED encodings stay SIGILL */
+	}
+	uint64_t m = is64 ? ~0ULL : 0xffffffffULL;
+	uint64_t old[2];
+	if (sweet_casp_user(base_addr(state, rn),
+	    reg_get(state, rs) & m, reg_get(state, rs + 1) & m,
+	    reg_get(state, rt) & m, reg_get(state, rt + 1) & m, is64, old)) {
+		return false;
+	}
+	reg_set(state, rs, old[0] & m);
+	reg_set(state, rs + 1, old[1] & m);
+	return true;
+}
+
+/* LD<op>, ST<op> (Rt = XZR), SWP and LDAPR. */
+static bool
+emulate_rmw(arm_saved_state_t *state, uint32_t instr)
+{
+	unsigned size_log2 = instr >> 30;
+	unsigned rs = (instr >> 16) & 31, rn = (instr >> 5) & 31, rt = instr & 31;
+	unsigned o3 = (instr >> 15) & 1, opc = (instr >> 12) & 7;
+	user_addr_t addr = base_addr(state, rn);
+	uint64_t mask = size_mask(size_log2);
+	uint64_t operand = reg_get(state, rs) & mask;
+	uint64_t old, next, seen;
+
+	if (o3 && opc == 4) {
+		/* LDAPR: load-acquire (RCpc). Rs must be 31. */
+		if (rs != 31 || read_user(addr, size_log2, &old)) {
+			return false;
+		}
+		__builtin_arm_dmb(DMB_ISH);
+		reg_set(state, rt, result_value(old, size_log2));
+		return true;
+	}
+	if (o3 && opc != 0) {
+		return false;
+	}
+	if (read_user(addr, size_log2, &old)) {
+		return false;
+	}
+	for (unsigned tries = 0;; tries++) {
+		old &= mask;
+		if (o3) {
+			next = operand;                                    /* SWP */
+		} else {
+			switch (opc) {
+			case 0: next = old + operand; break;               /* ADD */
+			case 1: next = old & ~operand; break;              /* CLR */
+			case 2: next = old ^ operand; break;               /* EOR */
+			case 3: next = old | operand; break;               /* SET */
+			case 4: next = sign_extend(old, size_log2) > sign_extend(operand, size_log2) ? old : operand; break; /* SMAX */
+			case 5: next = sign_extend(old, size_log2) < sign_extend(operand, size_log2) ? old : operand; break; /* SMIN */
+			case 6: next = old > operand ? old : operand; break;  /* UMAX */
+			default: next = old < operand ? old : operand; break; /* UMIN */
+			}
+		}
+		next &= mask;
+		if (sweet_cas_user(addr, old, next, size_log2, &seen)) {
+			return false;
+		}
+		if ((seen & mask) == old) {
+			break;
+		}
+		old = seen;
+		if (tries > 1000000) {
+			return false;
+		}
+	}
+	reg_set(state, rt, result_value(old, size_log2));
+	return true;
+}
+
+bool
+sweet_lse_emulate(arm_saved_state_t *state, uint32_t instr)
+{
+	bool ok;
+
+	if (!is_saved_state64(state)) {
+		return false;
+	}
+	if ((instr & 0x3fa07c00) == 0x08a07c00) {
+		ok = emulate_cas(state, instr);                 /* CAS{A,L,AL}{B,H,} */
+	} else if ((instr & 0xbfa07c00) == 0x08207c00) {
+		ok = emulate_casp(state, instr);                /* CASP{A,L,AL} */
+	} else if ((instr & 0x3f200c00) == 0x38200000) {
+		ok = emulate_rmw(state, instr);                 /* LD<op>, ST<op>, SWP, LDAPR */
+	} else {
+		return false;
+	}
+	if (!ok) {
+		return false;
+	}
+	uint64_t n = os_atomic_inc(&sweet_lse_emulated, relaxed);
+	if (os_atomic_load(&sweet_lse_logged, relaxed) < 32 &&
+	    os_atomic_inc_orig(&sweet_lse_logged, relaxed) < 32) {
+		char name[32] = "?";
+		task_t task = current_task();
+		if (task && get_bsdtask_info(task)) {
+			extern void proc_name(int pid, char *buf, int size);
+			extern int proc_selfpid(void);
+			proc_name(proc_selfpid(), name, sizeof(name));
+		}
+		printf("SWEET LSE: emulated #%llu instr 0x%08x at pc 0x%llx in %s\n",
+		    n, instr, (uint64_t)get_saved_state_pc(state), name);
+	}
+	return true;
+}
+#endif /* SWEET */
