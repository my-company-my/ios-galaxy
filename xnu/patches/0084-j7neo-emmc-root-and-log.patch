--- /dev/null
+++ b/bsd/dev/sweet_mmc.c
@@ -0,0 +1,1094 @@
+/*
+ * Galaxy J7 Neo internal eMMC root device.
+ *
+ * Exynos 7870 mmc0 is a Synopsys DesignWare MSHC with Samsung's security
+ * unit ("samsung,exynos7870-dw-mshc-smu", 0x13540000). S-BOOT loaded our
+ * boot image from it, so the card is initialized, selected and in the
+ * transfer state, with bus width and timing (up to HS400) set in both the
+ * card and the controller. This driver reuses that state like the Linux
+ * driver after a warm handover would not: it never resets the card, never
+ * changes the clock, the bus width or the timing. It finds the card's RCA
+ * with SEND_STATUS, reads EXT_CSD, makes sure the user area (not a boot
+ * partition) is selected, and then issues polled, one-at-a-time IDMAC
+ * transfers through one physically contiguous bounce buffer.
+ *
+ * It finds one GPT partition by name (boot-arg mmcroot=, default
+ * "USERDATA", compared without case) and exposes it as the BSD disk
+ * mmcroot0 (rmmcroot0). Root on it with rd=mmcroot0.
+ *
+ * Writes are refused unless boot-arg mmcrw=1 is set. Every write is checked
+ * against the partition bounds again right before it is issued, so nothing
+ * outside the named partition can be written (EFS, bootloaders, recovery
+ * and the other partitions are never touched).
+ *
+ * The controller is not cache coherent: caches are cleaned/invalidated
+ * around each transfer.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/* osfmk/arm/cpu_data.h, not exported to the BSD layer */
+extern int get_preemption_level(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+static void sweet_log_start(void);
+extern void sweet_sample_start(void);
+extern void sweet_keys_init(void);
+extern void sweet_touch_init(void);
+extern void sweet_usb_probe(void);
+
+/* DesignWare MSHC registers (Linux drivers/mmc/host/dw_mmc.h, dw_mmc-exynos.h) */
+#define MSHC_CTRL               0x000
+#define MSHC_CLKENA             0x010
+#define MSHC_CTYPE              0x018
+#define MSHC_BLKSIZ             0x01c
+#define MSHC_BYTCNT             0x020
+#define MSHC_INTMASK            0x024
+#define MSHC_CMDARG             0x028
+#define MSHC_CMD                0x02c
+#define MSHC_RESP0              0x030
+#define MSHC_RINTSTS            0x044
+#define MSHC_STATUS             0x048
+#define MSHC_HCON               0x070
+#define MSHC_BMOD               0x080
+#define MSHC_PLDMND             0x084
+#define MSHC_DBADDR             0x088   /* 32-bit IDMAC */
+#define MSHC_IDSTS              0x08c
+#define MSHC_DBADDRL            0x088   /* 64-bit IDMAC */
+#define MSHC_DBADDRU            0x08c
+#define MSHC_IDSTS64            0x090
+#define MSHC_CLKSEL64           0x0a8
+#define MSHC_MPSBEGIN0          0x1200  /* Exynos security unit (SMU) */
+#define MSHC_MPSEND0            0x1204
+#define MSHC_MPSCTRL0           0x120c
+
+#define CTRL_FIFO_RESET         (1u << 1)
+#define CTRL_DMA_RESET          (1u << 2)
+#define CTRL_INT_ENABLE         (1u << 4)
+#define CTRL_USE_IDMAC          (1u << 25)
+
+#define INT_RE                  (1u << 1)
+#define INT_CMD_DONE            (1u << 2)
+#define INT_DATA_OVER           (1u << 3)
+#define INT_RCRC                (1u << 6)
+#define INT_DCRC                (1u << 7)
+#define INT_RTO                 (1u << 8)
+#define INT_DRTO                (1u << 9)
+#define INT_HTO                 (1u << 10)
+#define INT_FRUN                (1u << 11)
+#define INT_HLE                 (1u << 12)
+#define INT_SBE                 (1u << 13)
+#define INT_ACD                 (1u << 14)
+#define INT_EBE                 (1u << 15)
+#define INT_CMD_ERRORS          (INT_RE | INT_RCRC | INT_RTO | INT_HLE)
+#define INT_DATA_ERRORS         (INT_DCRC | INT_DRTO | INT_HTO | INT_FRUN | INT_SBE | INT_EBE)
+
+#define CMD_START               (1u << 31)
+#define CMD_USE_HOLD_REG        (1u << 29)
+#define CMD_PRV_DAT_WAIT        (1u << 13)
+#define CMD_SEND_STOP           (1u << 12)
+#define CMD_DAT_WR              (1u << 10)
+#define CMD_DAT_EXP             (1u << 9)
+#define CMD_RESP_CRC            (1u << 8)
+#define CMD_RESP_EXP            (1u << 6)
+
+#define STATUS_DATA_BUSY        (1u << 9)
+#define HCON_ADDR64             (1u << 27)
+
+#define BMOD_SWRESET            (1u << 0)
+#define BMOD_FB                 (1u << 1)
+#define BMOD_DE                 (1u << 7)
+
+#define IDMAC_DES0_DIC          (1u << 1)
+#define IDMAC_DES0_LD           (1u << 2)
+#define IDMAC_DES0_FD           (1u << 3)
+#define IDMAC_DES0_CH           (1u << 4)
+#define IDMAC_DES0_OWN          (1u << 31)
+#define IDMAC_INT_FBE           (1u << 2)
+#define IDMAC_INT_CES           (1u << 5)
+#define IDMAC_INT_CLR           0x3ff
+
+#define MPSCTRL_NS_RW_VALID     ((1u << 6) | (1u << 5) | (1u << 4) | (1u << 0))
+
+/* eMMC */
+#define MMC_BLOCK               512u
+#define MMC_CMD_SWITCH          6
+#define MMC_CMD_SELECT          7
+#define MMC_CMD_SEND_EXT_CSD    8
+#define MMC_CMD_SEND_STATUS     13
+#define MMC_CMD_READ_SINGLE     17
+#define MMC_CMD_READ_MULTI      18
+#define MMC_CMD_WRITE_SINGLE    24
+#define MMC_CMD_WRITE_MULTI     25
+#define R1_ERRORS               0xfdf98080u     /* Linux R1_* error bits */
+#define R1_STATE(r)             (((r) >> 9) & 0xf)
+#define R1_STATE_STBY           3
+#define R1_STATE_TRAN           4
+#define EXT_CSD_FLUSH_CACHE     32
+#define EXT_CSD_CACHE_CTRL      33
+#define EXT_CSD_PART_CONFIG     179
+#define EXT_CSD_SEC_COUNT       212
+
+#define BOUNCE_SIZE             (1u << 20)
+#define DESC_DATA_MAX           4096u
+#define DESC_COUNT              (BOUNCE_SIZE / DESC_DATA_MAX)
+#define CMD_TIMEOUT_NS          (2ull * NSEC_PER_SEC)
+#define DATA_TIMEOUT_NS         (10ull * NSEC_PER_SEC)
+#define BUSY_TIMEOUT_NS         (30ull * NSEC_PER_SEC)
+#define POLL_SPIN_NS            (50ull * NSEC_PER_USEC)
+#define POLL_SLEEP_NS           (200ull * NSEC_PER_USEC)
+
+struct idmac_desc32 {
+	uint32_t des0, des1, des2, des3;
+};
+
+struct idmac_desc64 {
+	uint32_t des0, des1, des2, des3, des4, des5, des6, des7;
+};
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_DESC        0x0000                  /* up to 256 x 32 bytes */
+#define DMA_BOUNCE      0x4000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	bool addr64;                            /* HCON: 64-bit IDMAC descriptors */
+	uint32_t hold;                          /* CMD_USE_HOLD_REG or 0 */
+	uint32_t rca;
+	uint64_t card_sectors;                  /* EXT_CSD SEC_COUNT */
+	bool cache_on;                          /* EXT_CSD CACHE_CTRL */
+	uint64_t first_block, nblocks;          /* partition, in 512-byte sectors */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	bool writable;                          /* boot-arg mmcrw=1 */
+	bool wait;                              /* boot-arg mmcwait=1: sleep while polling */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} sm;
+
+static LCK_GRP_DECLARE(sweet_mmc_grp, "sweet_mmc");
+static LCK_MTX_DECLARE(sweet_mmc_lock, &sweet_mmc_grp);
+
+static inline uint32_t
+mshc_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sm.regs + off);
+}
+
+static inline void
+mshc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(sm.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(sm.dma_pa + off), len, TRUE);
+}
+
+static void
+dma_clean(uint32_t off, uint32_t len)
+{
+	clean_dcache64((addr64_t)(sm.dma_pa + off), len, TRUE);
+}
+
+/*
+ * Wait until (reg & mask) == want. Spins first, then (mmcwait=1, thread
+ * context) sleeps between polls. Returns 0 or ETIMEDOUT.
+ */
+static int
+mshc_wait(uint32_t reg, uint32_t mask, uint32_t want, uint64_t timeout_ns)
+{
+	uint64_t deadline, spin_until = 0, sleep_interval = 0;
+	nanoseconds_to_absolutetime(timeout_ns, &deadline);
+	deadline += mach_absolute_time();
+	bool sleepable = sm.wait && sm.ready && ml_get_interrupts_enabled() &&
+	    !ml_at_interrupt_context() && get_preemption_level() == 0;
+	if (sleepable) {
+		nanoseconds_to_absolutetime(POLL_SPIN_NS, &spin_until);
+		spin_until += mach_absolute_time();
+		nanoseconds_to_absolutetime(POLL_SLEEP_NS, &sleep_interval);
+	}
+	while ((mshc_rd(reg) & mask) != want) {
+		uint64_t now = mach_absolute_time();
+		if (now > deadline) {
+			return ETIMEDOUT;
+		}
+		if (sleepable && now >= spin_until) {
+			uint64_t wake = now + MIN(sleep_interval, deadline - now);
+			if (assert_wait_deadline_with_leeway((event_t)&sm.wait, THREAD_UNINT,
+			    TIMEOUT_URGENCY_SYS_CRITICAL, wake, 0) == THREAD_WAITING) {
+				thread_block(THREAD_CONTINUE_NULL);
+			}
+		} else {
+			delay(1);
+		}
+	}
+	return 0;
+}
+
+/* Wait for any of the bits in mask to appear in RINTSTS. */
+static int
+mshc_wait_int(uint32_t mask, uint64_t timeout_ns, uint32_t *status)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(timeout_ns, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		uint32_t s = mshc_rd(MSHC_RINTSTS);
+		if (s & mask) {
+			*status = s;
+			return 0;
+		}
+		if (mach_absolute_time() > deadline) {
+			*status = s;
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+}
+
+static int
+mshc_reset_bits(uint32_t bits)
+{
+	mshc_wr(MSHC_CTRL, mshc_rd(MSHC_CTRL) | bits);
+	return mshc_wait(MSHC_CTRL, bits, 0, CMD_TIMEOUT_NS);
+}
+
+/*
+ * Send one command. data_len: 0, or bytes moved by the IDMAC from/to the
+ * bounce buffer (descriptors already prepared). Returns 0 or an errno;
+ * *resp gets RESP0 (R1).
+ */
+static int
+mshc_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t data_len, uint32_t *resp)
+{
+	uint32_t s;
+	int error;
+
+	/* The card may still be busy programming the previous write. */
+	error = mshc_wait(MSHC_STATUS, STATUS_DATA_BUSY, 0, BUSY_TIMEOUT_NS);
+	if (error) {
+		printf("SWEET MMC: card busy before CMD%u\n", idx);
+		return error;
+	}
+	mshc_wr(MSHC_RINTSTS, 0xffffffff);
+	mshc_wr(MSHC_CMDARG, arg);
+	__builtin_arm_dsb(0xf);
+	mshc_wr(MSHC_CMD, CMD_START | sm.hold | CMD_PRV_DAT_WAIT | flags | idx);
+	error = mshc_wait_int(INT_CMD_DONE | INT_CMD_ERRORS, CMD_TIMEOUT_NS, &s);
+	if (error || (s & INT_CMD_ERRORS)) {
+		if (idx != MMC_CMD_SEND_STATUS) {
+			printf("SWEET MMC: CMD%u arg 0x%x failed: rintsts 0x%x%s\n", idx, arg, s,
+			    error ? " (timeout)" : "");
+		}
+		mshc_wr(MSHC_RINTSTS, 0xffffffff);
+		return error ? error : EIO;
+	}
+	if (resp) {
+		*resp = mshc_rd(MSHC_RESP0);
+	}
+	if (data_len) {
+		uint32_t want = INT_DATA_OVER | ((flags & CMD_SEND_STOP) ? INT_ACD : 0);
+		uint64_t deadline;
+		nanoseconds_to_absolutetime(DATA_TIMEOUT_NS, &deadline);
+		deadline += mach_absolute_time();
+		do {
+			s = mshc_rd(MSHC_RINTSTS);
+			if ((s & want) == want || (s & INT_DATA_ERRORS)) {
+				break;
+			}
+			if (mach_absolute_time() > deadline) {
+				error = ETIMEDOUT;
+				break;
+			}
+			delay(1);
+		} while (1);
+		uint32_t ids = mshc_rd(sm.addr64 ? MSHC_IDSTS64 : MSHC_IDSTS);
+		mshc_wr(sm.addr64 ? MSHC_IDSTS64 : MSHC_IDSTS, IDMAC_INT_CLR);
+		if (error || (s & INT_DATA_ERRORS) || (ids & (IDMAC_INT_FBE | IDMAC_INT_CES))) {
+			printf("SWEET MMC: CMD%u arg 0x%x data failed: rintsts 0x%x idsts 0x%x%s\n",
+			    idx, arg, s, ids, error ? " (timeout)" : "");
+			(void)mshc_reset_bits(CTRL_FIFO_RESET | CTRL_DMA_RESET);
+			mshc_wr(MSHC_RINTSTS, 0xffffffff);
+			return error ? error : EIO;
+		}
+	}
+	mshc_wr(MSHC_RINTSTS, 0xffffffff);
+	return 0;
+}
+
+static int
+mmc_check_r1(uint32_t idx, uint32_t r1)
+{
+	if (r1 & R1_ERRORS) {
+		printf("SWEET MMC: CMD%u card status 0x%08x\n", idx, r1);
+		return EIO;
+	}
+	return 0;
+}
+
+/* IDMAC descriptor chain over the first len bytes of the bounce buffer. */
+static void
+mshc_prepare_dma(uint32_t len)
+{
+	uint32_t n = (len + DESC_DATA_MAX - 1) / DESC_DATA_MAX;
+	uint64_t bounce_pa = sm.dma_pa + DMA_BOUNCE, desc_pa = sm.dma_pa + DMA_DESC;
+
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t chunk = MIN(DESC_DATA_MAX, len - i * DESC_DATA_MAX);
+		uint32_t des0 = IDMAC_DES0_OWN | IDMAC_DES0_CH | IDMAC_DES0_DIC;
+		if (i == 0) {
+			des0 |= IDMAC_DES0_FD;
+		}
+		if (i == n - 1) {
+			des0 = (des0 & ~(IDMAC_DES0_CH | IDMAC_DES0_DIC)) | IDMAC_DES0_LD;
+		}
+		uint64_t buf = bounce_pa + (uint64_t)i * DESC_DATA_MAX;
+		if (sm.addr64) {
+			struct idmac_desc64 *d = (struct idmac_desc64 *)(sm.dma + DMA_DESC) + i;
+			uint64_t next = desc_pa + (uint64_t)(i + 1) * sizeof(*d);
+			d->des1 = 0;
+			d->des2 = chunk & 0x1fff;
+			d->des3 = 0;
+			d->des4 = (uint32_t)buf;
+			d->des5 = (uint32_t)(buf >> 32);
+			d->des6 = (uint32_t)next;
+			d->des7 = (uint32_t)(next >> 32);
+			d->des0 = des0;
+		} else {
+			struct idmac_desc32 *d = (struct idmac_desc32 *)(sm.dma + DMA_DESC) + i;
+			d->des1 = chunk & 0x1fff;
+			d->des2 = (uint32_t)buf;
+			d->des3 = (uint32_t)(desc_pa + (uint64_t)(i + 1) * sizeof(*d));
+			d->des0 = des0;
+		}
+	}
+	dma_clean(DMA_DESC, n * (sm.addr64 ? sizeof(struct idmac_desc64) : sizeof(struct idmac_desc32)));
+	__builtin_arm_dsb(0xf);
+
+	(void)mshc_reset_bits(CTRL_FIFO_RESET | CTRL_DMA_RESET);
+	mshc_wr(MSHC_BMOD, mshc_rd(MSHC_BMOD) | BMOD_SWRESET);
+	(void)mshc_wait(MSHC_BMOD, BMOD_SWRESET, 0, CMD_TIMEOUT_NS);
+	mshc_wr(sm.addr64 ? MSHC_IDSTS64 : MSHC_IDSTS, IDMAC_INT_CLR);
+	if (sm.addr64) {
+		mshc_wr(MSHC_DBADDRL, (uint32_t)desc_pa);
+		mshc_wr(MSHC_DBADDRU, (uint32_t)(desc_pa >> 32));
+	} else {
+		mshc_wr(MSHC_DBADDR, (uint32_t)desc_pa);
+	}
+	mshc_wr(MSHC_CTRL, (mshc_rd(MSHC_CTRL) | CTRL_USE_IDMAC) & ~CTRL_INT_ENABLE);
+	mshc_wr(MSHC_BMOD, mshc_rd(MSHC_BMOD) | BMOD_DE | BMOD_FB);
+	mshc_wr(MSHC_BLKSIZ, MMC_BLOCK);
+	mshc_wr(MSHC_BYTCNT, len);
+	__builtin_arm_dsb(0xf);
+	mshc_wr(MSHC_PLDMND, 1);
+}
+
+/* One block-data command moving len bytes from/to the bounce buffer. */
+static int
+mmc_data_cmd(uint32_t idx, uint32_t arg, uint32_t len, bool write, bool stop)
+{
+	uint32_t r1 = 0;
+
+	if (write) {
+		dma_clean(DMA_BOUNCE, len);
+	} else {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	mshc_prepare_dma(len);
+	int error = mshc_cmd(idx, arg, CMD_RESP_EXP | CMD_RESP_CRC | CMD_DAT_EXP |
+	    (write ? CMD_DAT_WR : 0) | (stop ? CMD_SEND_STOP : 0), len, &r1);
+	if (!write) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	if (!error) {
+		error = mmc_check_r1(idx, r1);
+	}
+	if (!error && write) {
+		/* R1b of the (auto) stop / single write: wait for programming. */
+		error = mshc_wait(MSHC_STATUS, STATUS_DATA_BUSY, 0, BUSY_TIMEOUT_NS);
+	}
+	return error;
+}
+
+static int
+mmc_read_sectors(uint64_t lba, uint32_t count)
+{
+	if (count == 0 || count > BOUNCE_SIZE / MMC_BLOCK || lba + count > sm.card_sectors ||
+	    lba > UINT32_MAX) {
+		return EINVAL;
+	}
+	return mmc_data_cmd(count == 1 ? MMC_CMD_READ_SINGLE : MMC_CMD_READ_MULTI,
+	           (uint32_t)lba, count * MMC_BLOCK, false, count > 1);
+}
+
+/*
+ * Write count sectors from the bounce buffer to lba. The range must lie
+ * inside the partition: this is the only place data goes out.
+ */
+static int
+mmc_write_sectors(uint64_t lba, uint32_t count)
+{
+	if (!sm.writable || !sm.nblocks || count == 0 || count > BOUNCE_SIZE / MMC_BLOCK ||
+	    lba < sm.first_block || lba - sm.first_block >= sm.nblocks ||
+	    count > sm.nblocks - (lba - sm.first_block) || lba + count - 1 > UINT32_MAX) {
+		printf("SWEET MMC: refusing write of %u sectors at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	return mmc_data_cmd(count == 1 ? MMC_CMD_WRITE_SINGLE : MMC_CMD_WRITE_MULTI,
+	           (uint32_t)lba, count * MMC_BLOCK, true, count > 1);
+}
+
+/* CMD6 SWITCH, write one EXT_CSD byte (R1b). */
+static int
+mmc_switch(uint8_t index, uint8_t value)
+{
+	uint32_t r1 = 0;
+	int error = mshc_cmd(MMC_CMD_SWITCH, (3u << 24) | ((uint32_t)index << 16) | ((uint32_t)value << 8),
+	    CMD_RESP_EXP | CMD_RESP_CRC, 0, &r1);
+	if (!error) {
+		error = mmc_check_r1(MMC_CMD_SWITCH, r1);
+	}
+	if (!error) {
+		error = mshc_wait(MSHC_STATUS, STATUS_DATA_BUSY, 0, BUSY_TIMEOUT_NS);
+	}
+	if (!error) {
+		error = mshc_cmd(MMC_CMD_SEND_STATUS, sm.rca << 16, CMD_RESP_EXP | CMD_RESP_CRC, 0, &r1);
+	}
+	if (!error && (r1 & (1u << 7))) {
+		printf("SWEET MMC: SWITCH %u=0x%x rejected (status 0x%08x)\n", index, value, r1);
+		error = EIO;
+	}
+	return error;
+}
+
+static int
+mmc_sync_cache(void)
+{
+	return sm.cache_on ? mmc_switch(EXT_CSD_FLUSH_CACHE, 1) : 0;
+}
+
+/*
+ * Find the card's RCA (S-BOOT, like Linux, normally uses 1) and make sure
+ * it is selected (transfer state).
+ */
+static int
+mmc_find_card(void)
+{
+	uint32_t r1 = 0;
+
+	for (uint32_t rca = 1; rca <= 16; rca++) {
+		if (mshc_cmd(MMC_CMD_SEND_STATUS, rca << 16, CMD_RESP_EXP | CMD_RESP_CRC, 0, &r1)) {
+			continue;
+		}
+		sm.rca = rca;
+		uint32_t state = R1_STATE(r1);
+		printf("SWEET MMC: card at RCA %u, state %u, status 0x%08x\n", rca, state, r1);
+		if (state == R1_STATE_STBY) {
+			int error = mshc_cmd(MMC_CMD_SELECT, rca << 16, CMD_RESP_EXP | CMD_RESP_CRC, 0, &r1);
+			if (!error) {
+				error = mshc_wait(MSHC_STATUS, STATUS_DATA_BUSY, 0, BUSY_TIMEOUT_NS);
+			}
+			if (error) {
+				return error;
+			}
+		} else if (state != R1_STATE_TRAN) {
+			printf("SWEET MMC: card not in the transfer state\n");
+			return ENXIO;
+		}
+		return 0;
+	}
+	printf("SWEET MMC: no card answered SEND_STATUS (RCA 1-16)\n");
+	return ENXIO;
+}
+
+static int
+mmc_read_ext_csd(void)
+{
+	const uint8_t *ext = (const uint8_t *)(sm.dma + DMA_BOUNCE);
+	sm.card_sectors = UINT32_MAX;   /* until known; read below only touches 512 bytes */
+	int error = mmc_data_cmd(MMC_CMD_SEND_EXT_CSD, 0, MMC_BLOCK, false, false);
+	if (error) {
+		return error;
+	}
+	sm.card_sectors = (uint64_t)ext[EXT_CSD_SEC_COUNT] | (uint64_t)ext[EXT_CSD_SEC_COUNT + 1] << 8 |
+	    (uint64_t)ext[EXT_CSD_SEC_COUNT + 2] << 16 | (uint64_t)ext[EXT_CSD_SEC_COUNT + 3] << 24;
+	sm.cache_on = ext[EXT_CSD_CACHE_CTRL] & 1;
+	uint8_t part = ext[EXT_CSD_PART_CONFIG];
+	printf("SWEET MMC: EXT_CSD rev %u, %llu sectors (%llu MiB), cache %s, PARTITION_CONFIG 0x%02x\n",
+	    ext[192], sm.card_sectors, sm.card_sectors >> 11, sm.cache_on ? "on" : "off", part);
+	if (sm.card_sectors <= (2u << 21)) {
+		printf("SWEET MMC: card <= 2 GiB would be byte addressed: not supported\n");
+		return ENXIO;
+	}
+	if (part & 7) {
+		/* A boot or RPMB partition is selected: go back to the user area. */
+		return mmc_switch(EXT_CSD_PART_CONFIG, part & ~7);
+	}
+	return 0;
+}
+
+static bool
+name_equal_nocase(const char *a, const char *b)
+{
+	for (;; a++, b++) {
+		char x = (*a >= 'a' && *a <= 'z') ? (char)(*a - 32) : *a;
+		char y = (*b >= 'a' && *b <= 'z') ? (char)(*b - 32) : *b;
+		if (x != y) {
+			return false;
+		}
+		if (x == 0) {
+			return true;
+		}
+	}
+}
+
+static int
+mmc_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(sm.dma + DMA_BOUNCE);
+	int error = mmc_read_sectors(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET MMC: no GPT\n");
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET MMC: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = mmc_read_sectors(entry_lba, (nent * esz + MMC_BLOCK - 1) / MMC_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (!name_equal_nocase(name, want)) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first || last >= sm.card_sectors) {
+			return ENXIO;
+		}
+		sm.first_block = first;
+		sm.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("SWEET MMC: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+static int
+mshc_take_over_host(void)
+{
+	uint32_t ctrl = mshc_rd(MSHC_CTRL), clkena = mshc_rd(MSHC_CLKENA);
+	uint32_t hcon = mshc_rd(MSHC_HCON), ctype = mshc_rd(MSHC_CTYPE);
+	uint32_t clksel = mshc_rd(MSHC_CLKSEL64);
+
+	printf("SWEET MMC: ctrl 0x%x clkena 0x%x ctype 0x%x hcon 0x%x clksel 0x%x bmod 0x%x\n",
+	    ctrl, clkena, ctype, hcon, clksel, mshc_rd(MSHC_BMOD));
+	if (!(clkena & 1)) {
+		printf("SWEET MMC: card clock is off: the bootloader did not leave the card running\n");
+		return ENXIO;
+	}
+	if (((hcon >> 16) & 3) != 0) {
+		printf("SWEET MMC: host has no internal DMA (HCON 0x%x)\n", hcon);
+		return ENXIO;
+	}
+	sm.addr64 = (hcon & HCON_ADDR64) != 0;
+	if (!sm.addr64 && ((sm.dma_pa + DMA_SIZE - 1) >> 32)) {
+		printf("SWEET MMC: DMA memory above 4 GiB but 32-bit IDMAC\n");
+		return ENXIO;
+	}
+	/* Linux (dw_mci_exynos_set_clksel_timing): no drive phase shift -> no HOLD register. */
+	sm.hold = ((clksel >> 16) & 7) ? CMD_USE_HOLD_REG : 0;
+	/* Exynos SMU: plain (non-encrypted) access to the whole card, as Linux sets it. */
+	mshc_wr(MSHC_MPSBEGIN0, 0);
+	mshc_wr(MSHC_MPSEND0, 0xffffffff);
+	mshc_wr(MSHC_MPSCTRL0, MPSCTRL_NS_RW_VALID);
+	/* Polled operation: no controller interrupt reaches the GIC. */
+	mshc_wr(MSHC_INTMASK, 0);
+	mshc_wr(MSHC_CTRL, mshc_rd(MSHC_CTRL) & ~CTRL_INT_ENABLE);
+	mshc_wr(MSHC_RINTSTS, 0xffffffff);
+	return 0;
+}
+
+static int
+sweet_mmc_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!sm.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !sm.writable) ? EROFS : 0;
+}
+
+static int
+sweet_mmc_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_mmc_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * sm.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = sm.nblocks * MMC_BLOCK;
+
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !sm.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_mmc_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / MMC_BLOCK;
+		uint32_t skip = (uint32_t)(pos % MMC_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + MMC_BLOCK - 1) / MMC_BLOCK;
+		void *bounce = (void *)(sm.dma + DMA_BOUNCE);
+		if (rd) {
+			error = mmc_read_sectors(sm.first_block + lba, blocks);
+			if (!error) {
+				memcpy(vaddr + done, (const char *)bounce + skip, want);
+			}
+		} else {
+			/* Partial sectors at either end: read, merge, write back. */
+			if (skip || (want % MMC_BLOCK)) {
+				error = mmc_read_sectors(sm.first_block + lba, blocks);
+			}
+			if (!error) {
+				memcpy((char *)bounce + skip, vaddr + done, want);
+				error = mmc_write_sectors(sm.first_block + lba, blocks);
+			}
+		}
+		if (error) {
+			break;
+		}
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_mmc_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_mmc_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = sm.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > PAGE_SIZE || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		sm.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = MMC_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = sm.nblocks * MMC_BLOCK / sm.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = sm.writable;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		if (!sm.writable) {
+			return 0;
+		}
+		lck_mtx_lock(&sweet_mmc_lock);
+		int error = mmc_sync_cache();
+		lck_mtx_unlock(&sweet_mmc_lock);
+		return error;
+	}
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / sm.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = sm.writable ? BOUNCE_SIZE / sm.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_mmc_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_mmc_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_mmc_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_mmc_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_mmc_psize(__unused dev_t dev)
+{
+	return sm.ready ? (int)MIN(sm.nblocks * MMC_BLOCK / sm.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_mmc_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_mmc_strategy, NULL, dev, B_READ, minphys, uio, (int)sm.secsize);
+}
+
+static int
+sweet_mmc_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!sm.writable) {
+		return EROFS;
+	}
+	return physio(sweet_mmc_strategy, NULL, dev, B_WRITE, minphys, uio, (int)sm.secsize);
+}
+
+static const struct bdevsw sweet_mmc_bdevsw = {
+	.d_open     = sweet_mmc_open,
+	.d_close    = sweet_mmc_close,
+	.d_strategy = sweet_mmc_strategy,
+	.d_ioctl    = sweet_mmc_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_mmc_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_mmc_cdevsw = {
+	.d_open       = sweet_mmc_open,
+	.d_close      = sweet_mmc_close,
+	.d_read       = sweet_mmc_read,
+	.d_write      = sweet_mmc_write,
+	.d_ioctl      = sweet_mmc_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_mmc_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "USERDATA";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-mmc", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET MMC: no /sweet-mmc node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("mmcroot", want, sizeof(want));
+	uint32_t rw = 0, wait = 0;
+	PE_parse_boot_argn("mmcrw", &rw, sizeof(rw));
+	PE_parse_boot_argn("mmcwait", &wait, sizeof(wait));
+	sm.wait = (wait == 1);
+
+	sm.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &sm.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET MMC: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)sm.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	sm.dma_pa = ptoa_64(pn);
+	sm.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_mmc_lock);
+	error = mshc_take_over_host();
+	if (!error) {
+		error = mmc_find_card();
+	}
+	if (!error) {
+		error = mmc_read_ext_csd();
+	}
+	if (!error) {
+		error = mmc_find_partition(want);
+	}
+	lck_mtx_unlock(&sweet_mmc_lock);
+	if (error) {
+		return error;
+	}
+
+	sm.bmajor = bdevsw_add(-1, &sweet_mmc_bdevsw);
+	if (sm.bmajor < 0) {
+		return ENXIO;
+	}
+	sm.cmajor = cdevsw_add_with_bdev(-1, &sweet_mmc_cdevsw, sm.bmajor);
+	if (sm.cmajor < 0) {
+		return ENXIO;
+	}
+	sm.bdev = makedev(sm.bmajor, 0);
+	devfs_make_node(sm.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "mmcroot0");
+	devfs_make_node(makedev(sm.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rmmcroot0");
+	/* Only now, with the partition bounds known, can writes be allowed. */
+	sm.writable = (rw != 0);
+	sm.ready = true;
+	printf("SWEET MMC: \"%s\": first sector 0x%llx, %llu MiB, %s, RCA %u, %s IDMAC, DMA at 0x%llx\n",
+	    want, sm.first_block, sm.nblocks >> 11,
+	    sm.writable ? "read-write" : "read-only", sm.rca, sm.addr64 ? "64-bit" : "32-bit", sm.dma_pa);
+	sweet_log_start();
+	sweet_sample_start();
+	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
+	sweet_keys_init();
+	sweet_touch_init();
+	sweet_usb_probe();
+	return 0;
+}
+
+/*
+ * Persistent console log ("sweetlog"). Filming the phone screen is the only
+ * other way to see the console, so every character that reaches the
+ * console (kernel printf and /dev/console writes of daemons, both through
+ * _cnputs) is also kept in a 4 MiB ring, and once the partition is known
+ * and writable a thread copies new ring sectors to the LAST 4 MiB + 4 KiB
+ * of the partition every mmclogsecs seconds (default 10), far behind the
+ * HFS image at its start. The first 4 KiB of that area is a header:
+ *   "SWEETLOG" | u32 version 1 | u32 ring size | u64 total bytes written
+ *   | u64 flush sequence
+ * ring offset of byte n = n % ring size. Read it from TWRP with
+ * tools/sweet-log-pull.sh. Disabled with boot-arg sweetlog=0.
+ */
+#define SWEET_LOG_SIZE          (4u << 20)
+#define SWEET_LOG_HDR           4096u
+#define SWEET_LOG_SECTORS       ((SWEET_LOG_HDR + SWEET_LOG_SIZE) / MMC_BLOCK)
+#define SWEET_LOG_SECS          10u
+
+static char sweet_log_ring[SWEET_LOG_SIZE];
+static uint64_t _Atomic sweet_log_total;
+static int sweet_log_chan;
+static uint32_t sweet_log_secs = SWEET_LOG_SECS;
+
+/* Called for all console output, any context: never blocks. */
+void sweet_log_append(const char *c, int size);
+
+void
+sweet_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+	}
+}
+
+/*
+ * Copy console bytes [*pos, total) (at most max) for live log streaming
+ * (sweet_usb.c). A reader that fell more than the ring behind skips ahead.
+ * Returns the byte count; *pos advances.
+ */
+uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+
+uint32_t
+sweet_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total - *pos > SWEET_LOG_SIZE) {
+		*pos = total - SWEET_LOG_SIZE;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, total - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = sweet_log_ring[(*pos + i) % SWEET_LOG_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+
+uint64_t sweet_log_position(void);
+
+uint64_t
+sweet_log_position(void)
+{
+	return os_atomic_load(&sweet_log_total, relaxed);
+}
+
+struct sweet_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = sm.first_block + sm.nblocks - SWEET_LOG_SECTORS;
+	uint64_t ring_base = base + SWEET_LOG_HDR / MMC_BLOCK;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(sm.dma + DMA_BOUNCE);
+
+	printf("SWEET LOG: console log to the last %u KiB of the partition (sector 0x%llx)\n",
+	    (SWEET_LOG_HDR + SWEET_LOG_SIZE) >> 10, base);
+	for (;;) {
+		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
+		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
+		int error = 0;
+
+		lck_mtx_lock(&sweet_mmc_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+			uint32_t blk = off / MMC_BLOCK;
+			uint64_t need = ((uint64_t)off % MMC_BLOCK + (total - pos) + MMC_BLOCK - 1) / MMC_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / MMC_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / MMC_BLOCK));
+			memcpy(bounce, sweet_log_ring + (uint64_t)blk * MMC_BLOCK, n * MMC_BLOCK);
+			error = mmc_write_sectors(ring_base + blk, n);
+			pos += (uint64_t)(blk + n) * MMC_BLOCK - off;
+		}
+		if (!error) {
+			struct sweet_log_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			bzero(bounce, SWEET_LOG_HDR);
+			memcpy(bounce, &h, sizeof(h));
+			error = mmc_write_sectors(base, SWEET_LOG_HDR / MMC_BLOCK);
+		}
+		if (!error) {
+			error = mmc_sync_cache();
+		}
+		lck_mtx_unlock(&sweet_mmc_lock);
+		if (error) {
+			printf("SWEET LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+sweet_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !sm.writable || sm.nblocks < 2 * SWEET_LOG_SECTORS) {
+		return;
+	}
+	PE_parse_boot_argn("mmclogsecs", &sweet_log_secs, sizeof(sweet_log_secs));
+	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
+		sweet_log_secs = SWEET_LOG_SECS;
+	}
+	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* Root device for rd=mmcroot0 (IOFindBSDRoot). */
+int sweet_mmc_rootdev(dev_t *dev);
+
+int
+sweet_mmc_rootdev(dev_t *dev)
+{
+	if (!sm.ready) {
+		int error = sweet_mmc_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = sm.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- a/bsd/dev/sweet_ufs.c
+++ /dev/null
@@ -1,823 +0,0 @@
-/*
- * SWEET internal UFS root device.
- *
- * The Qualcomm UFS host (UFSHCI 2.1) is left enabled with the link up by the
- * bootloader, which loaded our boot image from it. This driver reuses that
- * state: it points the transfer request list at its own memory (verifying the
- * host took it before ringing any doorbell) and issues polled SCSI commands,
- * one at a time, to LUN 0. It finds one GPT partition by name (boot-arg
- * ufsroot=, default "userdata") and exposes it as the BSD disk ufsroot0
- * (rufsroot0), with 512-byte logical sectors over the device's 4 KiB blocks.
- * Root on it with rd=ufsroot0.
- *
- * All DMA goes through one physically contiguous allocation (descriptors and
- * a 1 MiB bounce buffer); the host is not cache coherent, so caches are
- * cleaned/invalidated around each command.
- *
- * Writes are refused unless boot-arg ufsrw=1 is set. Every write is checked
- * against the partition bounds again right before it is issued, so nothing
- * outside the named partition can be written.
- */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
-#include <sys/param.h>
-#include <sys/systm.h>
-#include <sys/buf.h>
-#include <sys/conf.h>
-#include <sys/disk.h>
-#include <sys/errno.h>
-#include <sys/proc.h>
-#include <sys/uio.h>
-#include <miscfs/devfs/devfs.h>
-#include <kern/locks.h>
-#include <kern/clock.h>
-#include <kern/sched_prim.h>
-#include <machine/machine_routines.h>
-#include <arm/caches_internal.h>
-#include <vm/pmap.h>
-#include <vm/vm_kern.h>
-#include <pexpert/pexpert.h>
-#include <pexpert/device_tree.h>
-#include <libkern/libkern.h>
-#include <machine/atomic.h>
-
-extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
-/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
-extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
-/* osfmk/arm/cpu_data.h, not exported to the BSD layer */
-extern int get_preemption_level(void);
-extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
-extern void thread_deallocate(thread_t);
-extern int hz;
-static void sweet_log_start(void);
-extern void sweet_sample_start(void);
-extern void sweet_keys_init(void);
-extern void sweet_touch_init(void);
-extern void sweet_usb_probe(void);
-
-#define REG_CAP         0x00
-#define REG_IS          0x20
-#define REG_IE          0x24
-#define REG_HCS         0x30
-#define REG_HCE         0x34
-#define REG_UTRLBA      0x50
-#define REG_UTRLBAU     0x54
-#define REG_UTRLDBR     0x58
-#define REG_UTRLCLR     0x5c
-#define REG_UTRLRSR     0x60
-
-#define HCS_DP          (1u << 0)
-#define HCS_UTRLRDY     (1u << 1)
-#define CAP_64AS        (1u << 24)              /* 64-bit DMA addressing */
-
-#define UFS_BLOCK       4096u
-#define BOUNCE_SIZE     (1u << 20)
-#define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
-#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
-#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
-#define CMD_SPIN_NS     (50ull * NSEC_PER_USEC)
-#define CMD_SLEEP_NS    (200ull * NSEC_PER_USEC)
-
-struct utrd {
-	uint32_t dw0, dw1, dw2, dw3;
-	uint32_t ucdba, ucdbau;
-	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, DWORDs */
-	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
-};
-
-struct ucd {
-	uint8_t cmd[512];
-	uint8_t resp[512];
-	struct {
-		uint32_t addr_lo, addr_hi, rsvd, dbc;
-	} prdt[PRDT_MAX];
-};
-
-/* Layout of the contiguous DMA allocation. */
-#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
-#define DMA_UCD         0x1000                  /* 128 byte aligned */
-#define DMA_BOUNCE      0x4000
-#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
-
-static struct {
-	vm_offset_t regs;
-	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
-	uint64_t dma_pa;
-	uint8_t lun;
-	uint8_t tag;
-	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
-	uint32_t secsize;                       /* logical sector size for the BSD layer */
-	bool writable;                          /* boot-arg ufsrw=1 */
-	bool cache;                             /* boot-arg ufscache=1 */
-	bool wait;                              /* boot-arg ufswait=1 */
-	int bmajor, cmajor;
-	dev_t bdev;
-	bool ready;
-} su;
-
-static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
-static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
-
-static inline uint32_t
-ufs_rd(uint32_t off)
-{
-	return *(volatile uint32_t *)(su.regs + off);
-}
-
-static inline void
-ufs_wr(uint32_t off, uint32_t v)
-{
-	*(volatile uint32_t *)(su.regs + off) = v;
-}
-
-static void
-dma_sync(uint32_t off, uint32_t len)
-{
-	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
-}
-
-static void
-dma_clean(uint32_t off, uint32_t len)
-{
-	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
-}
-
-/*
- * One SCSI command in slot 0, data (if any) to/from the bounce buffer
- * (to the device when write is set). Returns 0 or an errno.
- */
-static int
-ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
-{
-	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
-	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
-	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
-
-	assert(len <= BOUNCE_SIZE);
-	bzero(utrd, sizeof(*utrd));
-	bzero(ucd, sizeof(*ucd));
-
-	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
-	ucd->cmd[1] = len ? (write ? 0x20 : 0x40) : 0x00;      /* W: data out, R: data in */
-	ucd->cmd[2] = su.lun;
-	ucd->cmd[3] = ++su.tag;
-	ucd->cmd[12] = (uint8_t)(len >> 24);
-	ucd->cmd[13] = (uint8_t)(len >> 16);
-	ucd->cmd[14] = (uint8_t)(len >> 8);
-	ucd->cmd[15] = (uint8_t)len;
-	memcpy(&ucd->cmd[16], cdb, cdb_len);
-
-	/* DD: 1 = memory to device, 2 = device to memory. */
-	utrd->dw0 = (1u << 28) | ((len ? (write ? 1u : 2u) : 0u) << 25) | (1u << 24);
-	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
-	utrd->ucdba = (uint32_t)ucd_pa;
-	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
-	utrd->resp = (512u / 4) << 16 | (512u / 4);
-	if (len) {
-		uint32_t n = 0;
-		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
-			uint32_t chunk = MIN(PRDT_CHUNK, len - done);
-			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
-			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
-			ucd->prdt[n].dbc = chunk - 1;
-		}
-		utrd->prdt = (1024u / 4) << 16 | n;
-	}
-
-	if (su.cache) {
-		dma_clean(DMA_UTRL, sizeof(*utrd));
-		dma_clean(DMA_UCD, 16 + cdb_len);
-		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
-		if (len) {
-			dma_clean(DMA_UCD + offsetof(struct ucd, prdt),
-			    (utrd->prdt & 0xffff) * sizeof(ucd->prdt[0]));
-		}
-	} else {
-		dma_sync(DMA_UTRL, sizeof(*utrd));
-		dma_sync(DMA_UCD, sizeof(*ucd));
-	}
-	if (len) {
-		if (su.cache && write) {
-			dma_clean(DMA_BOUNCE, len);
-		} else {
-			dma_sync(DMA_BOUNCE, len);
-		}
-	}
-	__builtin_arm_dsb(0xf);
-
-	ufs_wr(REG_UTRLDBR, 1);
-	uint64_t deadline;
-	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
-	deadline += mach_absolute_time();
-	bool sleepable = su.wait && su.ready && ml_get_interrupts_enabled() &&
-	    !ml_at_interrupt_context() && get_preemption_level() == 0;
-	uint64_t spin_until = 0, sleep_interval = 0;
-	if (sleepable) {
-		nanoseconds_to_absolutetime(CMD_SPIN_NS, &spin_until);
-		spin_until += mach_absolute_time();
-		nanoseconds_to_absolutetime(CMD_SLEEP_NS, &sleep_interval);
-	}
-	while (ufs_rd(REG_UTRLDBR) & 1) {
-		uint64_t now = mach_absolute_time();
-		if (now > deadline) {
-			ufs_wr(REG_UTRLCLR, ~1u);
-			printf("SWEET UFS: command 0x%02x timed out\n", cdb[0]);
-			return ETIMEDOUT;
-		}
-		if (sleepable && now >= spin_until) {
-			uint64_t wake = now + MIN(sleep_interval, deadline - now);
-			/* Keep the mutex: slot 0 and the bounce buffer are still owned. */
-			if (assert_wait_deadline_with_leeway((event_t)&su.wait, THREAD_UNINT,
-			    TIMEOUT_URGENCY_SYS_CRITICAL, wake, 0) == THREAD_WAITING) {
-				thread_block(THREAD_CONTINUE_NULL);
-			}
-		} else {
-			delay(1);
-		}
-	}
-	__builtin_arm_dsb(0xf);
-	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
-
-	dma_sync(DMA_UTRL, sizeof(*utrd));
-	if (su.cache) {
-		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
-	} else {
-		dma_sync(DMA_UCD, sizeof(*ucd));
-	}
-	if (len && !(su.cache && write)) {
-		dma_sync(DMA_BOUNCE, len);
-	}
-
-	uint32_t ocs = utrd->dw2 & 0xff;
-	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
-		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
-		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
-		return EIO;
-	}
-	return 0;
-}
-
-/* READ(10) of count device blocks at lba into the bounce buffer. */
-static int
-ufs_read_blocks(uint64_t lba, uint32_t count)
-{
-	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
-		return EINVAL;
-	}
-	uint8_t cdb[10] = {
-		0x28, 0,
-		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
-		0, (uint8_t)(count >> 8), (uint8_t)count, 0
-	};
-	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false);
-}
-
-/*
- * WRITE(10) of count device blocks from the bounce buffer to lba. The range
- * must lie inside the partition: this is the only place data goes out.
- */
-static int
-ufs_write_blocks(uint64_t lba, uint32_t count)
-{
-	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
-	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
-	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX) {
-		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
-		return EPERM;
-	}
-	uint8_t cdb[10] = {
-		0x2a, 0,
-		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
-		0, (uint8_t)(count >> 8), (uint8_t)count, 0
-	};
-	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
-}
-
-static int
-ufs_sync_cache(void)
-{
-	static const uint8_t cdb[10] = { 0x35 };       /* SYNCHRONIZE CACHE(10), whole LUN */
-	return ufs_scsi(cdb, sizeof(cdb), 0, false);
-}
-
-static int
-ufs_find_partition(const char *want)
-{
-	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
-	int error = ufs_read_blocks(1, 1);
-	if (error) {
-		return error;
-	}
-	if (memcmp(b, "EFI PART", 8) != 0) {
-		printf("SWEET UFS: LUN %u has no GPT\n", su.lun);
-		return ENXIO;
-	}
-	uint64_t entry_lba;
-	uint32_t nent, esz;
-	memcpy(&entry_lba, b + 72, 8);
-	memcpy(&nent, b + 80, 4);
-	memcpy(&esz, b + 84, 4);
-	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
-		printf("SWEET UFS: unsupported GPT entries %u x %u\n", nent, esz);
-		return ENXIO;
-	}
-	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
-	if (error) {
-		return error;
-	}
-	for (uint32_t i = 0; i < nent; i++) {
-		const uint8_t *e = b + i * esz;
-		char name[37];
-		unsigned c;
-		for (c = 0; c < 36; c++) {
-			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
-			if (ch == 0 || ch > 0x7f) {
-				break;
-			}
-			name[c] = (char)ch;
-		}
-		name[c] = 0;
-		if (strcmp(name, want) != 0) {
-			continue;
-		}
-		uint64_t first, last;
-		memcpy(&first, e + 32, 8);
-		memcpy(&last, e + 40, 8);
-		if (last < first) {
-			return ENXIO;
-		}
-		su.first_block = first;
-		su.nblocks = last - first + 1;
-		return 0;
-	}
-	printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
-	return ENOENT;
-}
-
-static int
-ufs_take_over_host(void)
-{
-	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
-	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
-		printf("SWEET UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
-		return ENXIO;
-	}
-	if (ufs_rd(REG_UTRLDBR)) {
-		printf("SWEET UFS: requests outstanding from the bootloader\n");
-		return EBUSY;
-	}
-	/* With RAM above 4 GiB (mkadt.py --highmem) the DMA memory can be there too. */
-	if (((su.dma_pa + DMA_SIZE - 1) >> 32) && !(ufs_rd(REG_CAP) & CAP_64AS)) {
-		printf("SWEET UFS: DMA memory at 0x%llx but the host has no 64-bit addressing\n",
-		    su.dma_pa);
-		return ENXIO;
-	}
-	ufs_wr(REG_IE, 0);                      /* polled operation */
-	ufs_wr(REG_IS, ufs_rd(REG_IS));
-	ufs_wr(REG_UTRLRSR, 0);
-	uint64_t list = su.dma_pa + DMA_UTRL;
-	ufs_wr(REG_UTRLBA, (uint32_t)list);
-	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
-	ufs_wr(REG_UTRLRSR, 1);
-	/* Never ring a doorbell unless the host uses our list. */
-	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
-	    !(ufs_rd(REG_UTRLRSR) & 1)) {
-		printf("SWEET UFS: host did not take our request list\n");
-		return EIO;
-	}
-	return 0;
-}
-
-static int
-sweet_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
-{
-	if (!su.ready) {
-		return ENXIO;
-	}
-	return ((flags & FWRITE) && !su.writable) ? EROFS : 0;
-}
-
-static int
-sweet_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
-{
-	return 0;
-}
-
-static void
-sweet_ufs_strategy(buf_t bp)
-{
-	int error = 0;
-	caddr_t vaddr = NULL;
-	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
-	uint32_t count = buf_count(bp);
-	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
-
-	bool rd = buf_flags(bp) & B_READ;
-
-	buf_setresid(bp, count);
-	if (!rd && !su.writable) {
-		error = EROFS;
-		goto done;
-	}
-	if (off > part_bytes || count > part_bytes - off) {
-		error = EINVAL;
-		goto done;
-	}
-	if (count == 0) {
-		goto done;
-	}
-	if (buf_map(bp, &vaddr)) {
-		error = EIO;
-		goto done;
-	}
-
-	lck_mtx_lock(&sweet_ufs_lock);
-	for (uint32_t done = 0; done < count;) {
-		uint64_t pos = off + done;
-		uint64_t lba = pos / UFS_BLOCK;
-		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
-		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
-		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
-		void *bounce = (void *)(su.dma + DMA_BOUNCE);
-		if (rd) {
-			error = ufs_read_blocks(su.first_block + lba, blocks);
-			if (!error) {
-				memcpy(vaddr + done, (const char *)bounce + skip, want);
-			}
-		} else {
-			/* Partial device blocks at either end: read, merge, write back. */
-			if (skip || (want % UFS_BLOCK)) {
-				error = ufs_read_blocks(su.first_block + lba, blocks);
-			}
-			if (!error) {
-				memcpy((char *)bounce + skip, vaddr + done, want);
-				error = ufs_write_blocks(su.first_block + lba, blocks);
-			}
-		}
-		if (error) {
-			break;
-		}
-		done += want;
-		buf_setresid(bp, count - done);
-	}
-	lck_mtx_unlock(&sweet_ufs_lock);
-	buf_unmap(bp);
-
-done:
-	if (error) {
-		buf_seterror(bp, error);
-	}
-	buf_biodone(bp);
-}
-
-static int
-sweet_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
-    __unused struct proc *p, int is_char)
-{
-	uint32_t *f = (uint32_t *)data;
-	uint64_t *o = (uint64_t *)data;
-
-	switch (cmd) {
-	case DKIOCGETBLOCKSIZE:
-		*f = su.secsize;
-		return 0;
-	case DKIOCSETBLOCKSIZE:
-		if (is_char) {
-			return ENODEV;
-		}
-		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
-			return EINVAL;
-		}
-		su.secsize = *f;
-		return 0;
-	case DKIOCGETPHYSICALBLOCKSIZE:
-		*f = UFS_BLOCK;
-		return 0;
-	case DKIOCGETBLOCKCOUNT:
-		*o = su.nblocks * UFS_BLOCK / su.secsize;
-		return 0;
-	case DKIOCISWRITABLE:
-		*f = su.writable;
-		return 0;
-	case DKIOCSYNCHRONIZE:
-	case DKIOCSYNCHRONIZECACHE: {
-		if (!su.writable) {
-			return 0;
-		}
-		lck_mtx_lock(&sweet_ufs_lock);
-		int error = ufs_sync_cache();
-		lck_mtx_unlock(&sweet_ufs_lock);
-		return error;
-	}
-	case DKIOCGETMAXBLOCKCOUNTREAD:
-		*o = BOUNCE_SIZE / su.secsize;
-		return 0;
-	case DKIOCGETMAXBLOCKCOUNTWRITE:
-		*o = su.writable ? BOUNCE_SIZE / su.secsize : 0;
-		return 0;
-	case DKIOCGETMAXSEGMENTCOUNTREAD:
-	case DKIOCGETMAXSEGMENTCOUNTWRITE:
-		*o = 1;
-		return 0;
-	default:
-		return ENOTTY;
-	}
-}
-
-static int
-sweet_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
-{
-	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 0);
-}
-
-static int
-sweet_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
-{
-	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 1);
-}
-
-static int
-sweet_ufs_psize(__unused dev_t dev)
-{
-	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
-}
-
-static int
-sweet_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
-{
-	return physio(sweet_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
-}
-
-static int
-sweet_ufs_write(dev_t dev, struct uio *uio, __unused int ioflag)
-{
-	if (!su.writable) {
-		return EROFS;
-	}
-	return physio(sweet_ufs_strategy, NULL, dev, B_WRITE, minphys, uio, (int)su.secsize);
-}
-
-static const struct bdevsw sweet_ufs_bdevsw = {
-	.d_open     = sweet_ufs_open,
-	.d_close    = sweet_ufs_close,
-	.d_strategy = sweet_ufs_strategy,
